+static LPCWSTR GetWeaselRegName() {
+  LPCWSTR WEASEL_REG_NAME_;
+  if (is_wow64())
+    WEASEL_REG_NAME_ = L"Software\\WOW6432Node\\Rime\\Weasel";
+  else
+    WEASEL_REG_NAME_ = L"Software\\Rime\\Weasel";
+
+  return WEASEL_REG_NAME_;
+}
