+void WeaselTSF::_ProcessKeyEvent(ITfContext* pContext,
+                                 const com_ptr<CCandidateList>& candidate,
+                                 WPARAM wParam,
+                                 LPARAM lParam,
+                                 BOOL* pfEaten) {
+  *pfEaten = FALSE;
+  const auto activation = _activation;
+  const auto current = [&]() {
+    return _CurrentActivation(activation) && candidate && _cand == candidate;
+  };
+  if (!current()) return;
+  auto& keys = activation->keyState;
+  const DWORD shiftMessageTime = (wParam == VK_SHIFT || wParam == VK_LSHIFT ||
+      wParam == VK_RSHIFT) ? static_cast<DWORD>(GetMessageTime()) : 0;
+  _PromptTrace(prompt_trace::KeyEnter, pContext);
+  // when _IsKeyboardDisabled don't eat the key,
+  // when keyboard closable and keyboard closed, don't eat the key
+  const bool open = !_isToOpenClose || _IsKeyboardOpen();
+  if (!current()) return;
+  if (!open) {
+    _PromptTrace(prompt_trace::KeyBypass, pContext, nullptr, prompt_trace::BypassClosed);
+    *pfEaten = FALSE;
+    return;
+  }
+  const bool disabled = _IsKeyboardDisabled(pContext);
+  if (!current()) return;
+  if (disabled) {
+    _PromptTrace(prompt_trace::KeyBypass, pContext, nullptr, prompt_trace::BypassDisabled);
+    *pfEaten = FALSE;
+    return;
+  }
+
+  // if server connection is Not OK, don't eat it.
+  const bool connected = _EnsureServerConnected();
+  if (!current()) return;
+  if (!connected) {
+    _PromptTrace(prompt_trace::KeyBypass, pContext, nullptr, prompt_trace::BypassServer);
+    *pfEaten = FALSE;
+    return;
+  }
+  weasel::KeyEvent ke;
+  BYTE keyState[256];
+  const BOOL keyboardStateValid = GetKeyboardState(keyState);
+  if (!keyboardStateValid) {
+    _PromptTrace(prompt_trace::KeyBypass, pContext, nullptr, prompt_trace::BypassConvert);
+    return; // Never convert using a previous callback's keyboard bitmap.
+  }
+  if (!ConvertKeyEvent(static_cast<UINT>(wParam), lParam, keyState, ke)) {
+    /* Unknown key event */
+    _PromptTrace(prompt_trace::KeyBypass, pContext, nullptr, prompt_trace::BypassConvert);
+    *pfEaten = FALSE;
+  } else {
+    if (ke.keycode == ibus::Shift_L || ke.keycode == ibus::Shift_R)
+      ke.shift_snapshot = weasel::CaptureShiftSnapshot(ke, KeyInfo(lParam),
+          keyboardStateValid, keyState, GetKeyboardLayout(0),
+          static_cast<UINT>(wParam), shiftMessageTime);
+    // cheet key code when vertical auto reverse happened, swap up and down
+    if (candidate->GetIsReposition()) {
+      if (ke.keycode == ibus::Up)
+        ke.keycode = ibus::Down;
+      else if (ke.keycode == ibus::Down)
+        ke.keycode = ibus::Up;
+    }
+    const bool pendingCaps = ke.keycode == ibus::Caps_Lock && keys.simulatedCapsKeys > 0;
+    if (!pendingCaps) {
+      *pfEaten = (BOOL)_ProduceKeyResponse(pContext, ke);
+      if (!current()) return; // Keep handled, but never inject a stale Caps tail into B.
+      const std::uint64_t kind = ke.keycode == ibus::space ? prompt_trace::SpaceSelection :
+          (ke.keycode >= '1' && ke.keycode <= '9') ? prompt_trace::DigitSelection :
+          ke.keycode == ibus::Return ? prompt_trace::ReturnKey : 0;
+      _PromptTrace(prompt_trace::KeyReturned, pContext, nullptr,
+          kind | ((ke.mask & ibus::RELEASE_MASK) ? prompt_trace::KeyRelease : 0) |
+          (*pfEaten ? prompt_trace::OperationTrue : 0));
+    } else {
+      _PromptTrace(prompt_trace::KeyBypass, pContext, nullptr, prompt_trace::BypassSimulated);
+    }
+
+    if (ke.keycode == ibus::Caps_Lock) {
+      if (pendingCaps) {
+        // Only Caps callbacks that entered with an obligation can consume it.
+        --keys.simulatedCapsKeys;
+      } else if (keys.previousWasCaps && keys.previousEaten == TRUE &&
+          (ke.mask & ibus::RELEASE_MASK)) {
+        if ((GetKeyState(VK_CAPITAL) & 0x01)) {
+          if (_committed || (!*pfEaten && _HasCurrentPreedit())) {
+            INPUT inputs[2];
+            inputs[0].type = INPUT_KEYBOARD;
+            inputs[0].ki = {VK_CAPITAL, 0, 0, 0, 0};
+            inputs[1].type = INPUT_KEYBOARD;
+            inputs[1].ki = {VK_CAPITAL, 0, KEYEVENTF_KEYUP, 0, 0};
+            const UINT sent = ::SendInput(sizeof(inputs) / sizeof(INPUT), inputs, sizeof(INPUT));
+            // Zero creates no obligation; a partial insertion owns only sent.
+            // The creator callback never consumes a newly created obligation.
+            keys.simulatedCapsKeys = static_cast<int>(sent);
+          }
+        }
+        *pfEaten = TRUE;
+      }
+    }
+
+    keys.previousEaten = *pfEaten;
+    keys.previousWasCaps = ke.keycode == ibus::Caps_Lock;
+  }
+}
+
+STDAPI WeaselTSF::OnSetFocus(BOOL fForeground) {
+  _PromptTrace(prompt_trace::KeyFocus, _pEditSessionContext, nullptr,
+      fForeground ? prompt_trace::OperationTrue : 0);
+  if (fForeground) {
+    const com_ptr<CCandidateList> candidate = _cand;
+    if (!candidate) return S_OK;
+    _ApplyGlobalKeyboardOpen();
+    if (_cand != candidate) return S_OK;
+    m_client.FocusIn();
+  } else {
+    m_client.FocusOut();
+    _AbortComposition();
+  }
+
+  return S_OK;
+}
+
+// Test offers this activation the Actual callback without engine mutation or
+// retained context/keystroke credits. Actual supplies the final handled result.
+bool WeaselTSF::_TestKeyEventEligibility(ITfContext* context) {
+  const auto activation = _activation;
+  const com_ptr<CCandidateList> candidate = _cand;
+  const auto current = [&]() {
+    return _CurrentActivation(activation) && candidate && _cand == candidate;
+  };
+  if (!current()) return false;
+  const bool open = !_isToOpenClose || _IsKeyboardOpen();
+  if (!current() || !open) return false;
+  const bool disabled = _IsKeyboardDisabled(context);
+  return current() && !disabled;
+}
+
+STDAPI WeaselTSF::OnTestKeyDown(ITfContext* context, WPARAM, LPARAM, BOOL* eaten) {
+  if (!eaten) return E_POINTER;
+  const std::uint64_t flags = prompt_trace::TestDownCallback;
+  _PromptTrace(prompt_trace::CallbackEnter, context, nullptr, flags,
+      S_OK, -1, -1, -1, 0);
+  *eaten = _TestKeyEventEligibility(context);
+  _PromptTrace(prompt_trace::CallbackReturned, context, nullptr,
+      flags | (*eaten ? prompt_trace::OperationTrue : 0), S_OK, -1, -1, -1, 0);
+  return S_OK;
+}
+
+STDAPI WeaselTSF::OnKeyDown(ITfContext* context, WPARAM key, LPARAM info, BOOL* eaten) {
+  if (!eaten) return E_POINTER;
+  const com_ptr<CCandidateList> candidate = _cand;
+  const std::uint64_t flags = prompt_trace::ActualDownCallback;
+  _PromptTrace(prompt_trace::CallbackEnter, context, nullptr, flags);
+  _ProcessKeyEvent(context, candidate, key, info, eaten);
+  _PromptTrace(prompt_trace::CallbackReturned, context, nullptr,
+      flags | (*eaten ? prompt_trace::OperationTrue : 0));
+  return S_OK;
+}
+
+STDAPI WeaselTSF::OnTestKeyUp(ITfContext* context, WPARAM, LPARAM, BOOL* eaten) {
+  if (!eaten) return E_POINTER;
+  const std::uint64_t flags = prompt_trace::TestUpCallback;
+  _PromptTrace(prompt_trace::CallbackEnter, context, nullptr, flags,
+      S_OK, -1, -1, -1, 0);
+  *eaten = _TestKeyEventEligibility(context);
+  _PromptTrace(prompt_trace::CallbackReturned, context, nullptr,
+      flags | (*eaten ? prompt_trace::OperationTrue : 0), S_OK, -1, -1, -1, 0);
+  return S_OK;
+}
+
+STDAPI WeaselTSF::OnKeyUp(ITfContext* context, WPARAM key, LPARAM info, BOOL* eaten) {
+  if (!eaten) return E_POINTER;
+  const com_ptr<CCandidateList> candidate = _cand;
+  const std::uint64_t flags = prompt_trace::ActualUpCallback;
+  _PromptTrace(prompt_trace::CallbackEnter, context, nullptr, flags);
+  _ProcessKeyEvent(context, candidate, key, info, eaten);
+  _PromptTrace(prompt_trace::CallbackReturned, context, nullptr,
+      flags | (*eaten ? prompt_trace::OperationTrue : 0));
+  return S_OK;
+}
+
+STDAPI WeaselTSF::OnPreservedKey(ITfContext* pContext,
+                                 REFGUID rguid,
+                                 BOOL* pfEaten) {
+  *pfEaten = FALSE;
+  const auto activation = _activation;
+  if (activation && activation->globalOpenEnabled &&
+      IsEqualGUID(rguid, activation->preservedCommand) && !_IsKeyboardDisabled() &&
+      _CurrentActivation(activation)) {
+    *pfEaten = SUCCEEDED(_ToggleGlobalKeyboardOpen());
+  }
+  return S_OK;
+}
+
+BOOL WeaselTSF::_InitKeyEventSink(const Activation& activation) {
+  if (!_CurrentActivation(activation)) return FALSE;
+  const com_ptr<ITfKeyEventSink> sink = activation->keySink;
+  const com_ptr<ITfThreadMgr> thread = activation->thread;
+  if (!_CurrentActivation(activation)) return FALSE;
+  com_ptr<ITfKeystrokeMgr> manager;
+  HRESULT result = thread->QueryInterface(&manager);
+  if (result != S_OK || !_CurrentActivation(activation)) return FALSE;
+  result = manager->AdviseKeyEventSink(activation->client, sink, TRUE);
+  if (result != S_OK || !_CurrentActivation(activation)) {
+    // Only this successful installation acquired an unadvise obligation.
+    if (result == S_OK)
+      activation->RecordCleanup(manager->UnadviseKeyEventSink(activation->client));
+    return FALSE;
+  }
+  activation->keyManager.Attach(manager.Detach());
+  activation->keyAdvised = true;
+  return TRUE;
+}
+
+void WeaselTSF::_UninitKeyEventSink(ActivationBindings& activation) {
+  const bool advised = activation.keyAdvised, preserved = activation.preservedKey;
+  activation.keyAdvised = activation.preservedKey = false;
+  com_ptr<ITfKeystrokeMgr> manager;
+  manager.Attach(activation.keyManager.Detach());
+  if (!manager) return;
+  if (preserved) activation.RecordCleanup(manager->UnpreserveKey(activation.preservedCommand, &kNativeOpenKey));
+  if (advised) activation.RecordCleanup(manager->UnadviseKeyEventSink(activation.client));
+  // Test never mutates the engine; retired proxies owe no Actual ACK.
+}
+
+BOOL WeaselTSF::_InitPreservedKey(const Activation& activation) {
+  if (!_CurrentActivation(activation) || !activation->keyManager) return FALSE;
+  // UnpreserveKey has no client/cookie parameter. Give this resource its own
+  // command identity, while keeping the existing physical Ctrl+Space command.
+  GUID command;
+  if (FAILED(CoCreateGuid(&command))) return FALSE;
+  const com_ptr<ITfKeystrokeMgr> manager = activation->keyManager;
+  if (!_CurrentActivation(activation)) return FALSE;
+  const HRESULT result = manager->PreserveKey(activation->client, command,
+      &kNativeOpenKey, L"", 0);
+  if (result != S_OK || !_CurrentActivation(activation)) {
+    if (result == S_OK)
+      activation->RecordCleanup(manager->UnpreserveKey(command, &kNativeOpenKey));
+    return FALSE;
+  }
+  activation->preservedCommand = command;
+  activation->preservedKey = true;
+  return TRUE;
+}
+
+void WeaselTSF::_UninitPreservedKey(ActivationBindings& activation) {
+  const bool registered = activation.preservedKey;
+  activation.preservedKey = false;
+  const com_ptr<ITfKeystrokeMgr> manager = activation.keyManager;
+  if (registered && manager)
+    activation.RecordCleanup(manager->UnpreserveKey(activation.preservedCommand, &kNativeOpenKey));
+}
