+class CInitialPointEditSession : public CEditSession {
+ public:
+  CInitialPointEditSession(com_ptr<WeaselTSF> service,
+      com_ptr<ITfContext> owner, std::function<bool()> current)
+      : CEditSession(service, owner), current_(std::move(current)) {}
+  STDMETHODIMP DoEditSession(TfEditCookie ec) override {
+    if (!current_()) return S_FALSE;
+    TF_SELECTION selection = {};
+    ULONG count = 0;
+    const HRESULT selected = _pContext->GetSelection(ec, TF_DEFAULT_SELECTION,
+        1, &selection, &count);
+    com_ptr<ITfRange> point;
+    point.Attach(selection.range);
+    if (!current_()) return S_FALSE;
+    if (selected != S_OK || count != 1 || !point) return E_FAIL;
+    BOOL empty = FALSE;
+    HRESULT result = point->IsEmpty(ec, &empty);
+    if (!current_()) return S_FALSE;
+    if (FAILED(result) || !empty) return E_FAIL;
+    com_ptr<ITfContext> owner;
+    result = point->GetContext(&owner);
+    if (!current_()) return S_FALSE;
+    const bool same = SUCCEEDED(result) &&
+        response_owner::SameIdentity(owner, _pContext);
+    if (!current_()) return S_FALSE;
+    if (!same) return E_INVALIDARG;
+    com_ptr<ITfRange> bookmark;
+    result = point->Clone(&bookmark);
+    if (!current_()) return S_FALSE;
+    if (FAILED(result)) return result;
+    result = bookmark->SetGravity(ec, TF_GRAVITY_FORWARD, TF_GRAVITY_FORWARD);
+    if (!current_()) return S_FALSE;
+    if (FAILED(result)) return result;
+    bookmark_ = bookmark;
+    return S_OK;
+  }
+  com_ptr<ITfRange> bookmark_;
+ private:
+  std::function<bool()> current_;
+};
+
+void WeaselTSF::_CaptureInitialPoint(const std::shared_ptr<response_owner::Packet>& packet) {
+  if (!packet || !packet->source) return;
+  const auto source = packet->source;
+  if (source->range || source->composition || source->initialPoint ||
+      source->followsCommit || !source->initialSelection ||
+      source->initialPointResult != E_PENDING) return;
+  const auto current = [this, packet, source]() {
+    return _lastResponse == packet && _responseIntent == source &&
+        source->valid && !source->cancelled && !source->range &&
+        !source->composition && !source->followsCommit;
+  };
+  com_ptr<CInitialPointEditSession> point;
+  point.Attach(new CInitialPointEditSession(this, source->owner, current));
+  HRESULT granted = E_FAIL;
+  const HRESULT requested = source->owner->RequestEditSession(source->clientId, point,
+      TF_ES_SYNC | TF_ES_READ, &granted);
+  source->initialPointResult = FAILED(requested) ? requested : granted;
+  if (requested == S_OK && granted == S_OK && point->bookmark_ && current()) {
+    source->initialPoint = point->bookmark_;
+    source->initialPointResult = S_OK;
+  } else {
+    if (SUCCEEDED(source->initialPointResult)) source->initialPointResult = E_UNEXPECTED;
+    if (source->predecessor && !source->followsCommit)
+      source->initialSelection = false;
+  }
+  // A failed READ does not invent an insertion point. A fresh dependency
+  // still requires one when its delayed native grant finally arrives.
+}
+
+HRESULT WeaselTSF::_ResolveResponsePredecessor(
+    const std::shared_ptr<response_owner::Intent>& source, TfEditCookie ec) {
+  if (!source || !source->predecessor) return S_OK;
+  const auto predecessor = source->predecessor;
+  const auto dependency = response_owner::NativeDependency(predecessor);
+  if (dependency) {
+    if (FAILED(dependency->cleanupResult) && dependency->cleanupResult != E_PENDING)
+      return dependency->cleanupResult;
+    if (FAILED(dependency->writeResult) && dependency->writeResult != E_PENDING)
+      return dependency->writeResult;
+    // A native FIFO violation or true unfinished/failed close is an error,
+    // never permission to start another native composition or queue a retry.
+    return E_UNEXPECTED;
+  }
+  if (source->followsCommit) {
+    if (!predecessor->textWritten || !predecessor->endAnchorValid)
+      return E_UNEXPECTED;
+    if (!source->range) {
+      HRESULT result = predecessor->endAnchor->Clone(&source->range);
+      if (SUCCEEDED(result)) result = source->range->Collapse(ec, TF_ANCHOR_END);
+      if (SUCCEEDED(result)) result = source->range->SetGravity(ec,
+          TF_GRAVITY_BACKWARD, TF_GRAVITY_BACKWARD);
+      if (FAILED(result)) return result;
+    }
+    source->initialSelection = false;
+  } else if (!source->range && !source->initialPoint) {
+    // Old work may have moved the selection. Fresh B cannot silently use its
+    // grant-time caret after it failed to save its own original empty point.
+    return E_UNEXPECTED;
+  }
+  source->predecessor.reset();
+  return S_OK;
+}
