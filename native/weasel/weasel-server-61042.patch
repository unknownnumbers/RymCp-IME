+// Shared value serialization: no engine request, commit read, or UI callback.
+static void AppendStatusMetadata(const RimeStatus& status,
+                                 std::set<std::string>& actions,
+                                 std::list<std::string>& messages) {
+  actions.insert("status");
+  messages.push_back("status.ascii_mode=" + std::to_string(status.is_ascii_mode) + '\n');
+  messages.push_back("status.composing=" + std::to_string(status.is_composing) + '\n');
+  messages.push_back("status.disabled=" + std::to_string(status.is_disabled) + '\n');
+  messages.push_back("status.full_shape=" + std::to_string(status.is_full_shape) + '\n');
+  messages.push_back("status.schema_id=" + std::string(status.schema_id) + '\n');
+}
+
+static void AppendStyleMetadata(const UIStyle& style, bool include_style,
+                                std::set<std::string>& actions,
+                                std::list<std::string>& messages) {
+  actions.insert("config");
+  messages.push_back("config.inline_preedit=" +
+                     std::to_string(static_cast<int>(style.inline_preedit)) + '\n');
+  if (include_style) {
+    std::wstringstream stream;
+    boost::archive::text_woarchive archive(stream);
+    archive << style;
+    actions.insert("style");
+    messages.push_back("style=" + wtou8(stream.str()) + '\n');
+  }
+}
+
+static bool EmitResponse(const std::set<std::string>& actions,
+                          std::list<std::string>& messages,
+                          const RequestHandler::EatLine& eat) {
+  messages.push_front(actions.empty() ? "action=noop\n" :
+                       "action=" + join(actions, ",") + '\n');
+  messages.push_back(".\n");
+  return std::all_of(messages.begin(), messages.end(),
+      [&eat](const std::string& message) {
+        auto wide = u8tow(message);
+        return eat(wide);
+      });
+}
+
+static bool ApplyModeStyle(const SessionStatus& session, int state, UIStyle& style) {
+  const auto layout = session.mode_horizontal[state]
+                          ? UIStyle::LAYOUT_HORIZONTAL : UIStyle::LAYOUT_VERTICAL;
+  const bool changed = style.layout_type != layout ||
+      style.candidate_spacing != session.mode_spacing[state] ||
+      style.comment_font_point != session.mode_comment_font_point[state];
+  if (changed) {
+    style.layout_type = layout;
+    style.candidate_spacing = session.mode_spacing[state];
+    style.comment_font_point = session.mode_comment_font_point[state];
+  }
+  return changed;
+}
