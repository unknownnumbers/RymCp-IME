+bool RimeWithWeaselHandler::QueryMetadata(WeaselSessionId ipc_id, EatLine eat) {
+  const auto found = m_session_status_map.find(ipc_id);
+  if (m_disabled || found == m_session_status_map.end() || !eat)
+    return false;
+  const SessionStatus& session = found->second;
+  RIME_STRUCT(RimeStatus, status);
+  if (!rime_api->get_status(session.session_id, &status)) return false;
+  const std::string schema_id = status.schema_id ? status.schema_id : "";
+  // Schema/app initialization belongs to the normal session/focus/content
+  // path. Do not pair fresh status with a different schema's cached style.
+  if (schema_id != ".default" && schema_id != session.mode_schema_id) {
+    rime_api->free_status(&status);
+    return false;
+  }
+  std::set<std::string> actions;
+  std::list<std::string> messages;
+  AppendStatusMetadata(status, actions, messages);
+  rime_api->free_status(&status);
+  // Schema/app metadata is initialized by AddSession and ordinary content or
+  // FocusIn refresh. Derive the current global-mode overlay without mutating it.
+  UIStyle style = session.style;
+  if (!session.mode_option.empty())
+    ApplyModeStyle(session, !!rime_api->get_option(session.session_id,
+                       session.mode_option.c_str()), style);
+  AppendStyleMetadata(style, true, actions, messages);
+  // A query does not consume the content stream's __synced obligation.
+  return EmitResponse(actions, messages, eat);
+}
