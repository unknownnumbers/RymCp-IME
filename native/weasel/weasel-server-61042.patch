+static bool explore(const std::wstring& path) {
+  std::wstring quoted_path = L"\"" + path + L"\"";
+  return (uintptr_t)ShellExecuteW(NULL, L"explore", quoted_path.c_str(), NULL,
+                                  NULL, SW_SHOWNORMAL) > 32;
+}
