+STDAPI CLangBarItemButton::InitMenu(ITfMenu* pMenu) {
+  HMENU menu = LoadMenuW(g_hInst, MAKEINTRESOURCE(IDR_MENU_POPUP));
+  HMENU popupMenu = GetSubMenu(menu, 0);
+  HMENU2ITfMenu(popupMenu, pMenu);
+  DestroyMenu(menu);
+  return S_OK;
+}
