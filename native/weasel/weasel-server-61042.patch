+#include "stdafx.h"
+#include "WeaselTSF.h"
+#include "EditSession.h"
+#include "ResponseParser.h"
+#include "CandidateList.h"
+
+// The current host selection is independent of an old commit's write address.
+// F/F anchors track the actual write, including a caret after later raw text.
+// Only TSF-visible notifications/explicit operations revoke this snapshot;
+// unnotified host changes inside a native call cannot be inferred here.
+struct SavedResponseSelection {
+  std::shared_ptr<response_owner::SelectionState> state;
+  std::uint64_t revision = 0;
+  com_ptr<ITfRange> range;
+  TF_SELECTIONSTYLE style = {};
+
+  bool Current() const { return state && state->revision == revision; }
+  HRESULT Capture(TfEditCookie ec, const std::shared_ptr<response_owner::Intent>& source) {
+    state = source->selection;
+    revision = state->revision;
+    TF_SELECTION selected = {};
+    ULONG count = 0;
+    HRESULT result = source->owner->GetSelection(ec, TF_DEFAULT_SELECTION, 1, &selected, &count);
+    com_ptr<ITfRange> actual;
+    actual.Attach(selected.range);
+    if (FAILED(result)) return result;
+    if (result != S_OK || count != 1 || !actual || !Current()) return E_UNEXPECTED;
+    style = selected.style;
+    result = actual->Clone(&range);
+    if (FAILED(result)) return result;
+    if (!range || !Current()) return E_UNEXPECTED;
+    result = range->SetGravity(ec, TF_GRAVITY_FORWARD, TF_GRAVITY_FORWARD);
+    return FAILED(result) ? result : (Current() ? S_OK : E_UNEXPECTED);
+  }
+};
+
+/* Original-context document close */
+void WeaselTSF::_QueueEndDraft(
+    const std::shared_ptr<response_owner::Intent>& target, bool clear) {
+  using namespace response_owner;
+  if (!target) return;
+  const com_ptr<CCandidateList> candidate = _cand;
+  const bool wasCurrent = _responseIntent == target;
+  target->valid = false;
+  if (wasCurrent) _responseIntent.reset();
+  auto source = target;
+  std::shared_ptr<Packet> work = source->nativeWork.lock();
+  if (!source->composition && source->predecessor) {
+    // A captured selected P owns its write and native close. Cancellation of
+    // its successor must not submit a parallel End before P has written.
+    work = source->predecessor;
+    if (work->source) source = work->source;
+  }
+  // A successor's blur cannot authorize its selected predecessor to discover
+  // a later caret. Captured ranges/points and the commit itself remain owned.
+  if (target->cancelled && !source->range && !source->initialPoint)
+    source->initialSelection = false;
+  work = CleanupForAction(source, work, clear);
+  com_ptr<ITfComposition> retiredMirror;
+  if (source->composition && _IsCurrentComposition(source->composition)) {
+    _PromptTrace(prompt_trace::Finalized, source->owner, source->composition);
+    retiredMirror.Attach(_pComposition.Detach());
+  }
+  if (wasCurrent) {
+    _status.composing = false;
+    if (target->cancelled) _committed = TRUE;
+  }
+  if (target->cancelled && _engineResponseIntent.lock() == target && !target->preparing) {
+    m_client.ClearComposition();
+    if (_engineResponseIntent.lock() == target) _engineResponseIntent.reset();
+  }
+  const auto bridge = work ? _EnsureDependencyBridge(work) : nullptr;
+  if (wasCurrent && !_responseIntent && bridge) _responseIntent = bridge;
+  // Submit before any UI callback can produce B. Existing work is idempotent.
+  if (work) _QueueResponse(work);
+  if (candidate) {
+    candidate->CancelUI(target);
+    if (source != target) candidate->CancelUI(source);
+  }
+}
+
+// EndDraft owns native closure. It may remove text only when this service
+// actually wrote that exact inline preedit into the same native composition.
+static HRESULT ClearOwnedInlinePreedit(TfEditCookie ec,
+    const std::shared_ptr<response_owner::Intent>& source,
+    const com_ptr<ITfComposition>& native, const com_ptr<ITfRange>& range,
+    SavedResponseSelection& selection, HRESULT& selectionResult, bool& attempted) {
+  const std::wstring expected = source->inlinePreeditText;
+  if (expected.empty()) return S_OK;  // Non-inline drafts own no document text.
+  const auto owns = [&]() {
+    return source->composition.p == native.p && !source->terminated &&
+        !source->preparing && !source->hasCommit && !source->captureFailed &&
+        source->inlinePreeditText == expected;
+  };
+  if (!owns()) return S_OK;
+  // One extra UTF-16 unit distinguishes an exact match from a matching prefix
+  // that has absorbed host text. No unbounded GetText or null-terminated scan.
+  std::wstring observed(expected.size() + 1, L'\0');
+  ULONG read = 0;
+  HRESULT result = range->GetText(ec, 0, &observed[0],
+      static_cast<ULONG>(observed.size()), &read);
+  if (FAILED(result)) return result;
+  if (result != S_OK || !owns() || read != expected.size() ||
+      observed.compare(0, read, expected) != 0) return S_OK;
+  // Selection preservation cannot withdraw the independently proven clear.
+  selectionResult = selection.Capture(ec, source);
+  if (!owns()) return FAILED(selectionResult) ? selectionResult : S_OK;
+  attempted = true;
+  result = range->SetText(ec, 0, L"", 0);
+  if (result == S_OK && owns()) source->inlinePreeditText.clear();
+  return FAILED(selectionResult) ? selectionResult : result;
+}
+
+HRESULT WeaselTSF::_DeliverEndDraft(
+    const std::shared_ptr<response_owner::Packet>& packet, TfEditCookie ec) {
+  using namespace response_owner;
+  if (!packet || packet->kind != WorkKind::EndDraft || !packet->source)
+    return E_INVALIDARG;
+  if (packet->deliveryStarted || packet->stage != Stage::Closing) return S_FALSE;
+  packet->deliveryStarted = true;
+  const auto source = packet->source;
+  const com_ptr<ITfComposition> native = packet->endComposition;
+  HRESULT cleanup = S_OK;
+  SavedResponseSelection selection;
+  HRESULT selectionResult = E_PENDING;
+  bool attemptedClear = false;
+  if (native && !(source->composition.p == native.p && source->terminated)) {
+    com_ptr<ITfRange> range = packet->endRange;
+    // Inline SetText may have completed after EndDraft captured its point.
+    if (source->composition.p == native.p && !source->inlinePreeditText.empty())
+      range = source->range;
+    if (!range) cleanup = native->GetRange(&range);
+    if (SUCCEEDED(cleanup) && !range) cleanup = E_UNEXPECTED;
+    if (SUCCEEDED(cleanup)) {
+      _ClearCompositionDisplayAttributes(ec, source->owner, range);
+      if (packet->clearRange)
+        cleanup = ClearOwnedInlinePreedit(ec, source, native, range, selection,
+            selectionResult, attemptedClear);
+    }
+  }
+  const HRESULT ended = _CloseResponseComposition(ec, native, source,
+      packet->compositionClosed);
+  if (attemptedClear && selectionResult == S_OK) {
+    const HRESULT restored = selection.Current() ?
+        _SetResponseSelection(ec, source, selection.range, &selection.style) : E_UNEXPECTED;
+    if (SUCCEEDED(cleanup) && FAILED(restored)) cleanup = restored;
+  }
+  packet->cleanupResult = FAILED(cleanup) ? cleanup : ended;
+  packet->stage = SUCCEEDED(packet->cleanupResult) ? Stage::Done : Stage::Failed;
+  return packet->cleanupResult;
+}
+
+
+HRESULT WeaselTSF::_CloseResponseComposition(TfEditCookie ec,
+    com_ptr<ITfComposition> composition,
+    std::shared_ptr<response_owner::Intent> intent, bool& closed) {
+  closed = !composition;
+  if (!composition) return S_OK;
+  const bool matching = intent && intent->composition.p == composition.p;
+  if (matching && intent->terminated) {
+    closed = true;
+    return S_OK;
+  }
+  if (_IsCurrentComposition(composition)) _FinalizeComposition();
+  const HRESULT result = composition->EndComposition(ec);
+  bool observedClosed = false;
+  if (FAILED(result)) {
+    // GetRange has one documented E_UNEXPECTED meaning: already terminated.
+    // This is one observation of the exact object, not another End attempt.
+    com_ptr<ITfRange> observed;
+    observedClosed = composition->GetRange(&observed) == E_UNEXPECTED;
+  }
+  const bool stillMatching = intent && intent->composition.p == composition.p;
+  closed = SUCCEEDED(result) || observedClosed || (stillMatching && intent->terminated);
+  // Mark actual success only after native End returns. Its callback may have
+  // installed B, so never update the service's current intent here.
+  if (closed && stillMatching) intent->terminated = true;
+  return result;
+}
+
+/* Get Text Extent */
+class CGetTextExtentEditSession : public CEditSession {
+ public:
+  CGetTextExtentEditSession(com_ptr<WeaselTSF> service,
+      com_ptr<ITfContext> owner, com_ptr<ITfContextView> view,
+      com_ptr<ITfRange> range,
+      std::shared_ptr<response_owner::Packet> packet,
+      std::shared_ptr<response_owner::Intent> intent)
+      : CEditSession(service, owner), _view(view), _range(range),
+        _packet(packet), _intent(intent) {}
+
+  STDMETHODIMP DoEditSession(TfEditCookie ec);
+
+ private:
+  bool Current() const {
+    return _pTextService->_IsPresentedResponse(_packet) &&
+        _packet->outputIntent.lock() == _intent &&
+        _intent->range.p == _range.p;
+  }
+  HRESULT OwnedScreenBounds(RECT& bounds);
+  com_ptr<ITfContextView> _view;
+  com_ptr<ITfRange> _range;
+  std::shared_ptr<response_owner::Packet> _packet;
+  std::shared_ptr<response_owner::Intent> _intent;
+};
+
+HRESULT CGetTextExtentEditSession::OwnedScreenBounds(RECT& bounds) {
+  HRESULT result = _view->GetScreenExt(&bounds);
+  if (!Current()) return S_FALSE;
+  if (result == S_OK) {
+    // Zero display bounds mean this document is not displayed, not a
+    // request to borrow the foreground window's geometry.
+    return bounds.right > bounds.left && bounds.bottom > bounds.top ? S_OK : S_FALSE;
+  }
+  HWND window = nullptr;
+  result = _view->GetWnd(&window);
+  if (!Current()) return S_FALSE;
+  if (FAILED(result)) return result;
+  if (!window) return S_FALSE;  // Successful windowless GetWnd is valid.
+  if (!::GetWindowRect(window, &bounds)) return HRESULT_FROM_WIN32(GetLastError());
+  if (!Current()) return S_FALSE;
+  return bounds.right > bounds.left && bounds.bottom > bounds.top ? S_OK : S_FALSE;
+}
+
+STDAPI CGetTextExtentEditSession::DoEditSession(TfEditCookie ec) {
+  if (!Current()) return S_FALSE;
+  com_ptr<ITfContextView> active;
+  HRESULT result = _pContext->GetActiveView(&active);
+  if (!Current()) return S_FALSE;
+  if (FAILED(result)) return result;
+  const bool same_view = response_owner::SameIdentity(active, _view);
+  if (!Current() || !same_view) return S_FALSE;
+  com_ptr<ITfContext> range_owner;
+  result = _range->GetContext(&range_owner);
+  if (!Current()) return S_FALSE;
+  if (FAILED(result)) return result;
+  const bool same_owner = response_owner::SameIdentity(range_owner, _pContext);
+  if (!Current() || !same_owner) return S_FALSE;
+  com_ptr<ITfRange> query;
+  result = _range->Clone(&query);
+  if (!Current()) return S_FALSE;
+  if (FAILED(result)) return result;
+  result = query->Collapse(ec, TF_ANCHOR_START);
+  if (!Current()) return S_FALSE;
+  if (FAILED(result)) return result;
+  RECT rect = {};
+  BOOL clipped = FALSE;
+  const HRESULT text_result = _view->GetTextExt(ec, query, &rect, &clipped);
+  if (!Current()) return S_FALSE;
+  const bool has_text_rect = text_result == S_OK &&
+      (rect.left || rect.top || rect.right || rect.bottom);
+  const bool enhanced = _packet->response->style.enhanced_position;
+  RECT bounds = {};
+  const HRESULT bounds_result = enhanced ? OwnedScreenBounds(bounds) : S_FALSE;
+  if (!Current()) return S_FALSE;
+  if (has_text_rect) {
+    if (bounds_result == S_OK &&
+        (rect.left < bounds.left || rect.left > bounds.right ||
+         rect.top < bounds.top || rect.top > bounds.bottom)) {
+      // Retain the existing enhanced-position correction, but translate
+      // only to this view's own display edge. No thread/global caret guess.
+      ::OffsetRect(&rect, bounds.left - rect.left, bounds.top - rect.top);
+    }
+    // Clipped text still has a valid source-owned visible bounding box.
+    return _pTextService->_SetCompositionPosition(_packet, rect, false);
+  }
+  if (bounds_result == S_OK)
+    return _pTextService->_SetCompositionPosition(_packet, bounds, true);
+  // No new rectangle. A good position from this registration may remain;
+  // an unpositioned new registration must not reuse another context's rect.
+  return FAILED(text_result) ? text_result : S_FALSE;
+}
+
+/* Composition Window Handling */
+bool WeaselTSF::_IsPresentedResponse(
+    const std::shared_ptr<response_owner::Packet>& packet) const {
+  return packet && _cand && _cand->PresentedResponse() == packet;
+}
+
+HRESULT WeaselTSF::_UpdateCompositionWindow(
+    const std::shared_ptr<response_owner::Packet>& packet,
+    ITfContextView* expected_view) {
+  if (!_IsPresentedResponse(packet)) return S_FALSE;
+  const auto intent = packet->outputIntent.lock();
+  const com_ptr<ITfContext> owner = intent->owner;
+  const com_ptr<ITfRange> range = intent->range;
+  if (!range) return E_UNEXPECTED;
+  com_ptr<ITfContextView> view;
+  HRESULT result = owner->GetActiveView(&view);
+  if (!_IsPresentedResponse(packet)) return S_FALSE;
+  if (FAILED(result)) return result;
+  if (!view) return E_UNEXPECTED;
+  if (expected_view) {
+    const bool same = response_owner::SameIdentity(view, expected_view);
+    if (!_IsPresentedResponse(packet) || !same) return S_FALSE;
+  }
+  com_ptr<CGetTextExtentEditSession> session;
+  session.Attach(new CGetTextExtentEditSession(this, owner, view, range, packet, intent));
+  HRESULT granted = E_FAIL;
+  result = owner->RequestEditSession(intent->clientId, session,
+      TF_ES_ASYNC | TF_ES_READ, &granted);
+  return FAILED(result) ? result : granted;
+}
+
+HRESULT WeaselTSF::_SetCompositionPosition(
+    const std::shared_ptr<response_owner::Packet>& packet,
+    const RECT& rect, bool fallback) {
+  if (!_IsPresentedResponse(packet)) return S_FALSE;
+  // Keep a real position from the same physical registration in preference
+  // to its display-edge fallback. No rectangle is cached in this layer.
+  if (fallback && _cand->HasInputPosition(packet)) return S_FALSE;
+  if (!fallback && !_fCUASWorkaroundTested) {
+    _fCUASWorkaroundTested = TRUE;
+    if (rect.top == rect.bottom) {
+      _fCUASWorkaroundEnabled = TRUE;
+      return S_FALSE;
+    }
+  }
+  m_client.UpdateInputPosition(rect);
+  if (!_IsPresentedResponse(packet)) return S_FALSE;
+  return _cand->UpdateInputPosition(packet, rect);
+}
+
+/* Inline Preedit */
+class CInlinePreeditEditSession : public CEditSession {
+ public:
+  CInlinePreeditEditSession(com_ptr<WeaselTSF> pTextService,
+                            com_ptr<ITfContext> pContext,
+                            com_ptr<ITfComposition> pComposition,
+                            const std::shared_ptr<weasel::Context> context,
+                            const std::shared_ptr<response_owner::Packet>& packet = nullptr)
+      : CEditSession(pTextService, pContext),
+        _pComposition(pComposition),
+        _context(context), _packet(packet) {}
+
+  /* ITfEditSession */
+  STDMETHODIMP DoEditSession(TfEditCookie ec);
+
+ private:
+  com_ptr<ITfComposition> _pComposition;
+  const std::shared_ptr<weasel::Context> _context;
+  std::shared_ptr<response_owner::Packet> _packet;
+};
+
+STDAPI CInlinePreeditEditSession::DoEditSession(TfEditCookie ec) {
+  if (_packet && !_pTextService->_IsLatestResponse(_packet)) return S_FALSE;
+  std::wstring preedit = _context->preedit.str;
+
+  com_ptr<ITfRange> pRangeComposition;
+  if (_pComposition == nullptr)
+    return E_FAIL;
+  if ((_pComposition->GetRange(&pRangeComposition)) != S_OK)
+    return E_FAIL;
+  // Capture the actual native owner before SetText can call the host.
+  const auto intent = _pTextService->_FindResponseIntent(_pComposition);
+  if (_packet && !_pTextService->_IsLatestResponse(_packet)) return S_FALSE;
+  if (!intent || intent->composition.p != _pComposition.p) return E_UNEXPECTED;
+  const auto selectionState = intent->selection;
+  const auto selectionRevision = selectionState->revision;
+
+  // Retain the actual inline write range before caret collapse. The draft's
+  // independent empty insertion point must not be mistaken for inline text.
+  com_ptr<ITfRange> writtenRange;
+  HRESULT captured = pRangeComposition->Clone(&writtenRange);
+  if (SUCCEEDED(captured)) captured = writtenRange->SetGravity(ec,
+      TF_GRAVITY_BACKWARD,
+      preedit.empty() ? TF_GRAVITY_BACKWARD : TF_GRAVITY_FORWARD);
+  if (FAILED(captured)) return captured;
+  if (_packet && !_pTextService->_IsLatestResponse(_packet)) return S_FALSE;
+  if (intent->composition.p != _pComposition.p) return E_UNEXPECTED;
+  if ((pRangeComposition->SetText(ec, 0, preedit.c_str(),
+                                  static_cast<LONG>(preedit.length()))) != S_OK)
+    return E_FAIL;
+
+  // The write already happened. Retain its provenance even if a host
+  // callback cancelled A or captured B before the post-call latest test.
+  // Never attach A's successful write to a replacement native object.
+  if (intent->composition.p == _pComposition.p) {
+    intent->inlinePreeditText = std::move(preedit);
+    intent->range = writtenRange;
+  }
+  if (selectionState->revision != selectionRevision) return E_UNEXPECTED;
+  if (_packet && !_pTextService->_IsLatestResponse(_packet)) return S_FALSE;
+  /* TODO: Check the availability and correctness of these values */
+  int sel_cursor = -1;
+  for (size_t i = 0; i < _context->preedit.attributes.size(); i++) {
+    if (_context->preedit.attributes.at(i).type == weasel::HIGHLIGHTED) {
+      sel_cursor = _context->preedit.attributes.at(i).range.cursor;
+      break;
+    }
+  }
+
+  _pTextService->_SetCompositionDisplayAttributes(ec, _pContext,
+                                                  pRangeComposition);
+
+  if (_packet && !_pTextService->_IsLatestResponse(_packet)) return S_FALSE;
+  /* Set caret */
+  LONG cch;
+  if (sel_cursor < 0) {
+    pRangeComposition->Collapse(ec, TF_ANCHOR_END);
+  } else {
+    pRangeComposition->Collapse(ec, TF_ANCHOR_START);
+    pRangeComposition->ShiftStart(ec, sel_cursor, &cch, NULL);
+  }
+  if (_packet && !_pTextService->_IsLatestResponse(_packet)) return S_FALSE;
+  if (selectionState->revision != selectionRevision) return E_UNEXPECTED;
+  return _pTextService->_SetResponseSelection(ec, intent, pRangeComposition);
+}
+
+/* Composition State */
+STDAPI WeaselTSF::OnCompositionTerminated(TfEditCookie ecWrite,
+                                          ITfComposition* pComposition) {
+  const com_ptr<CCandidateList> candidate = _cand;
+  if (prompt_trace::Get().Enabled()) {
+    prompt_trace::LastErrorGuard preserve;
+    try {
+    com_ptr<ITfRange> observed;
+    const HRESULT result = pComposition ? pComposition->GetRange(&observed) : E_POINTER;
+    if (result == S_OK)
+      _PromptTraceRange(prompt_trace::Terminated, ecWrite, nullptr, pComposition, observed);
+    else
+      _PromptTrace(prompt_trace::Terminated, nullptr, pComposition, 0, result);
+    } catch (...) { prompt_trace::Get().Fail(); }
+  }
+  _ResponseTerminated(pComposition);
+  // NOTE:
+  // This will be called when an edit session ended up with an empty composition
+  // string, Even if it is closed normally. Silly M$.
+
+  // EndComposition() may generate this callback for the composition we just
+  // closed. Only an active, matching composition is an external termination.
+  if (!_IsCurrentComposition(pComposition))
+    return S_OK;
+
+  // The host has already ended this composition. Retire it before any
+  // COM call can reenter with a replacement composition. In particular,
+  // termination during SetText must not enqueue End(clear=true), which
+  // would erase the commit that is currently being delivered.
+  _FinalizeComposition();
+
+  // TSF clears GUID_PROP_COMPOSING, but does not clear our display
+  // attributes. Clean only the terminated range, using its own context
+  // and this callback's write cookie. Never erase text or end it again.
+  com_ptr<ITfRange> terminatedRange;
+  com_ptr<ITfContext> terminatedContext;
+  if (pComposition->GetRange(&terminatedRange) == S_OK && terminatedRange &&
+      terminatedRange->GetContext(&terminatedContext) == S_OK && terminatedContext)
+    _ClearCompositionDisplayAttributes(ecWrite, terminatedContext, terminatedRange);
+
+  // Preserve the engine draft, including legitimate non-inline empty-range
+  // termination and pending real commits. Cached status is used only for
+  // UI visibility, never as proof that engine text may be discarded.
+  if (candidate && !_HasCurrentPreedit() && !_IsComposing())
+    candidate->EndUI();
+  return S_OK;
+}
+
+void WeaselTSF::_AbortComposition(bool clear) {
+  const auto target = _responseIntent;
+  _AbortComposition(clear, target);
+}
+
+void WeaselTSF::_AbortComposition(bool clear,
+    const std::shared_ptr<response_owner::Intent>& target) {
+  if (!target) return;
+  // Revoke only the named old draft before any owner query or host callback.
+  // New input in the same context must obtain a new intent.
+  target->valid = false;
+  target->cancelled = true;
+  com_ptr<ITfRange> retiredSelection;
+  retiredSelection.Attach(target->ownSelection.Detach());
+  _PromptTrace(prompt_trace::AbortBegin, target->owner, target->composition,
+      clear ? prompt_trace::ClearRange : 0);
+  _QueueEndDraft(target, clear);
+  _PromptTrace(prompt_trace::AbortCleared, target->owner, target->composition);
+}
+
+void WeaselTSF::_FinalizeComposition() {
+  _PromptTrace(prompt_trace::Finalized, _pEditSessionContext, _pComposition);
+  _pComposition = nullptr;
+}
+
+void WeaselTSF::_SetComposition(com_ptr<ITfComposition> pComposition) {
+  _PromptTrace(prompt_trace::CurrentSet, _pEditSessionContext, pComposition);
+  _pComposition = pComposition;
+}
+
+BOOL WeaselTSF::_IsComposing() {
+  return _pComposition != NULL;
+}
+
+bool WeaselTSF::_HasCurrentPreedit() {
+  const auto packet = _lastResponse;
+  return packet && packet->response && packet->response->status.composing &&
+         _IsLatestResponse(packet);
+}
+
+BOOL WeaselTSF::_IsCurrentComposition(ITfComposition* pComposition) {
+  return _pComposition != nullptr && _pComposition == pComposition;
+}
+
+HRESULT WeaselTSF::_DeliverResponse(
+    const std::shared_ptr<response_owner::Packet>& packet, TfEditCookie ec) {
+  using namespace response_owner;
+  if (!packet || !packet->source) return E_INVALIDARG;
+  DeliveryFrame delivery(_responseDelivery, packet->source);
+  if (packet->kind == WorkKind::EndDraft) return _DeliverEndDraft(packet, ec);
+  if (!packet->response) return E_INVALIDARG;
+  if (packet->stage == Stage::Writing || packet->stage == Stage::Written ||
+      packet->stage == Stage::Done || packet->stage == Stage::Failed ||
+      packet->stage == Stage::UnsupportedEndpoint || packet->deliveryStarted) return S_FALSE;
+  const auto source = packet->source;
+  const auto response = packet->response;
+  const com_ptr<CCandidateList> candidate = _cand;
+  _PromptTrace(prompt_trace::UpdateGranted, source->owner, source->composition,
+      0, S_OK, response->commit.size(), response->context.preedit.str.size(), -1, response->generation);
+  const bool commit = !response->commit.empty();
+  packet->deliveryStarted = true;
+  if (!commit && !_IsLatestResponse(packet)) return S_FALSE;
+  if (commit) packet->stage = Stage::Writing; // Guard before any COM query.
+  const auto rejectCommit = [this, packet, source, ec](HRESULT failure, Stage stage,
+      const SavedResponseSelection* selection = nullptr, HRESULT selectionResult = S_OK) {
+    packet->writeResult = failure;
+    const com_ptr<ITfComposition> native = source->composition;
+    const HRESULT closed = _CloseResponseComposition(ec, native, source,
+        packet->compositionClosed);
+    packet->cleanupResult = FAILED(selectionResult) ? selectionResult : closed;
+    if (selection && selectionResult == S_OK) {
+      const HRESULT restored = selection->Current() ?
+          _SetResponseSelection(ec, source, selection->range, &selection->style) : E_UNEXPECTED;
+      if (SUCCEEDED(packet->cleanupResult) && FAILED(restored))
+        packet->cleanupResult = restored;
+    }
+    packet->stage = stage;
+    return failure;
+  };
+
+  // Resolve only a pre-existing anchor, a completed predecessor's end anchor,
+  // or a still-valid initial insertion. Failed old anchors never use selection.
+  HRESULT result = S_OK;
+  result = _ResolveResponsePredecessor(source, ec);
+  if (FAILED(result)) {
+    if (commit) return rejectCommit(result, Stage::UnsupportedEndpoint);
+    packet->stage = Stage::UnsupportedEndpoint;
+    packet->writeResult = result;
+    return result;
+  }
+  const bool bookmarked = !source->range && source->initialPoint != nullptr;
+  com_ptr<ITfRange> bookmarkPoint;
+  if (bookmarked) {
+    // The FF point was captured while R was valid, before focus cancellation.
+    // Build a distinct B/F write point only now, after earlier async work.
+    if (source->range || source->composition) result = E_UNEXPECTED;
+    else result = source->initialPoint->Clone(&bookmarkPoint);
+    com_ptr<ITfContext> owner;
+    BOOL empty = FALSE;
+    if (SUCCEEDED(result)) result = bookmarkPoint->GetContext(&owner);
+    if (SUCCEEDED(result) && !SameIdentity(owner, source->owner)) result = E_INVALIDARG;
+    if (SUCCEEDED(result)) result = bookmarkPoint->IsEmpty(ec, &empty);
+    if (SUCCEEDED(result) && !empty) result = E_UNEXPECTED;
+    if (SUCCEEDED(result)) result = bookmarkPoint->SetGravity(ec,
+        TF_GRAVITY_BACKWARD, TF_GRAVITY_BACKWARD);
+    if (SUCCEEDED(result)) {
+      source->range = bookmarkPoint;
+      source->initialSelection = false;
+    }
+  } else if (!source->range && source->composition) {
+    result = source->composition->GetRange(&source->range);
+  } else if (!source->range && source->initialSelection && source->valid && !source->cancelled) {
+    com_ptr<ITfInsertAtSelection> insertion;
+    com_ptr<ITfRange> queriedRange;
+    result = source->owner->QueryInterface(IID_ITfInsertAtSelection,
+        reinterpret_cast<void**>(&insertion));
+    if (SUCCEEDED(result)) result = insertion->InsertTextAtSelection(
+        ec, TF_IAS_QUERYONLY, nullptr, 0, &queriedRange);
+    // Preserve a genuine nonempty selected replacement. Only an observed
+    // empty insertion endpoint gets nonexpanding anchors.
+    BOOL empty = FALSE;
+    if (SUCCEEDED(result)) result = queriedRange->IsEmpty(ec, &empty);
+    if (SUCCEEDED(result) && empty) result = queriedRange->SetGravity(ec,
+        TF_GRAVITY_BACKWARD, TF_GRAVITY_BACKWARD);
+    // The query can reenter: a changed insertion intent is not the old point.
+    if (!source->valid || source->cancelled) result = E_UNEXPECTED;
+    if (SUCCEEDED(result)) {
+      source->range = queriedRange;
+      source->initialSelection = false;
+    }
+  }
+  if (SUCCEEDED(result) && source->range) {
+    com_ptr<ITfContext> owner;
+    result = source->range->GetContext(&owner);
+    if (SUCCEEDED(result) && !SameIdentity(owner, source->owner)) result = E_INVALIDARG;
+  } else if (SUCCEEDED(result)) result = E_UNEXPECTED;
+  _PromptTrace(prompt_trace::UpdateEndpointChecked, source->owner, source->composition,
+      0, result, -1, -1, -1, response->generation);
+  if (FAILED(result)) {
+    if (commit) return rejectCommit(result, Stage::UnsupportedEndpoint);
+    return result;
+  }
+
+  if (commit) {
+    // This immediate write clone expands over this write, not over host input
+    // while an earlier empty endpoint was waiting for its native grant.
+    com_ptr<ITfRange> writeRange;
+    result = source->range->Clone(&writeRange);
+    _PromptTrace(prompt_trace::CommitRangeCloned, source->owner, source->composition,
+        prompt_trace::PendingCommit | (writeRange ? prompt_trace::OperationTrue : 0),
+        result, response->commit.size(), -1, -1, response->generation);
+    if (SUCCEEDED(result)) {
+      result = writeRange->SetGravity(ec, TF_GRAVITY_BACKWARD, TF_GRAVITY_FORWARD);
+      _PromptTrace(prompt_trace::CommitRangeGravitySet, source->owner, source->composition,
+          prompt_trace::PendingCommit, result, response->commit.size(), -1, -1,
+          response->generation);
+    }
+    if (FAILED(result)) return rejectCommit(result, Stage::UnsupportedEndpoint);
+    if (!source->composition || source->terminated) {
+      // A terminated predecessor cannot also describe the replacement native
+      // object as closed while Start/SetText can call the host again.
+      packet->compositionClosed = false;
+      com_ptr<ITfContextComposition> compositions;
+      result = source->owner->QueryInterface(IID_ITfContextComposition,
+          reinterpret_cast<void**>(&compositions));
+      com_ptr<ITfComposition> composition;
+      if (SUCCEEDED(result)) {
+        result = compositions->StartComposition(ec, writeRange, this, &composition);
+        _PromptTrace(prompt_trace::StartCreated, source->owner, composition,
+            prompt_trace::PendingCommit | (composition ? prompt_trace::OperationTrue : 0),
+            result, response->commit.size(), -1, -1, response->generation);
+      }
+      if (FAILED(result) || !composition)
+        return rejectCommit(FAILED(result) ? result : E_UNEXPECTED,
+            Stage::UnsupportedEndpoint);
+      source->composition = composition;
+      source->terminated = false;
+    }
+    if (bookmarked) {
+      // StartComposition owns a different native range. It must still be the
+      // captured empty point, never a B/F range that has absorbed old P text.
+      const com_ptr<ITfComposition> created = source->composition;
+      com_ptr<ITfRange> writtenRange;
+      com_ptr<ITfContext> owner;
+      BOOL empty = FALSE;
+      LONG start = 1, end = 1;
+      result = created->GetRange(&writtenRange);
+      if (SUCCEEDED(result)) result = writtenRange->GetContext(&owner);
+      if (SUCCEEDED(result) && !SameIdentity(owner, source->owner)) result = E_INVALIDARG;
+      if (SUCCEEDED(result)) result = writtenRange->SetGravity(ec,
+          TF_GRAVITY_BACKWARD, TF_GRAVITY_FORWARD);
+      if (SUCCEEDED(result)) result = writtenRange->IsEmpty(ec, &empty);
+      if (SUCCEEDED(result) && !empty) result = E_UNEXPECTED;
+      if (SUCCEEDED(result)) result = writtenRange->CompareStart(ec,
+          source->initialPoint, TF_ANCHOR_START, &start);
+      if (SUCCEEDED(result)) result = writtenRange->CompareEnd(ec,
+          source->initialPoint, TF_ANCHOR_END, &end);
+      if (SUCCEEDED(result) && (start != 0 || end != 0)) result = E_UNEXPECTED;
+      if (FAILED(result))
+        return rejectCommit(result, Stage::UnsupportedEndpoint);
+      writeRange = writtenRange;
+    }
+    SavedResponseSelection selection;
+    // The verified writeRange authorizes this selected write. Saving the live
+    // selection is best-effort cleanup, never a second write prerequisite.
+    const HRESULT selectionResult = selection.Capture(ec, source);
+    ++packet->writeAttempts;
+    _PromptTrace(prompt_trace::InsertGranted, source->owner, source->composition,
+        prompt_trace::PendingCommit, S_OK, response->commit.size(), -1, -1, response->generation);
+    packet->writeResult = writeRange->SetText(ec, 0, response->commit.c_str(),
+        static_cast<LONG>(response->commit.size()));
+    _PromptTrace(prompt_trace::InsertWritten, source->owner, source->composition,
+        prompt_trace::PendingCommit, packet->writeResult,
+        response->commit.size(), -1, -1, response->generation);
+    if (FAILED(packet->writeResult))
+      return rejectCommit(packet->writeResult, Stage::Failed, &selection, selectionResult);
+    source->range = writeRange;
+    packet->textWritten = true;
+    // Writing includes native close and selection restoration. A callback must
+    // not mistake a still executing Written packet for a transferable failure.
+    HRESULT firstFailure = selectionResult;
+    result = source->range->Clone(&packet->endAnchor);
+    if (SUCCEEDED(result)) result = packet->endAnchor->Collapse(ec, TF_ANCHOR_END);
+    packet->endAnchorValid = SUCCEEDED(result);
+    if (SUCCEEDED(firstFailure) && FAILED(result)) firstFailure = result;
+    com_ptr<ITfProperty> attributes;
+    result = source->owner->GetProperty(GUID_PROP_ATTRIBUTE, &attributes);
+    if (SUCCEEDED(result)) result = attributes->Clear(ec, source->range);
+    if (SUCCEEDED(firstFailure) && FAILED(result)) firstFailure = result;
+    result = _CloseResponseComposition(ec, source->composition, source,
+        packet->compositionClosed);
+    if (SUCCEEDED(firstFailure) && FAILED(result)) firstFailure = result;
+    // SetText may have moved the host selection through its ACP implementation.
+    // Restore the tracked current host selection, never P's own end anchor.
+    if (selectionResult == S_OK) {
+      result = selection.Current() ?
+          _SetResponseSelection(ec, source, selection.range, &selection.style) : E_UNEXPECTED;
+      if (SUCCEEDED(firstFailure) && FAILED(result)) firstFailure = result;
+    }
+    // Actual native success, matching termination or the exact failed-End
+    // GetRange observation records closure. The End HRESULT remains intact.
+    packet->cleanupResult = firstFailure;
+    packet->stage = SUCCEEDED(firstFailure) ? Stage::Done : Stage::Written;
+    if (packet->stage != Stage::Done) {
+      _RetireRejectedEmptyUi(packet);
+      return firstFailure;
+    }
+  }
+
+  // The commit above is A-owned even if a COM call installed B. Every following
+  // language bar, preedit or candidate operation must still belong to latest A.
+  if (!_IsLatestResponse(packet)) return S_OK;
+  auto output = packet->outputIntent.lock();
+  if (!output) return S_OK;
+  if (output != source) {
+    result = _ResolveResponsePredecessor(output, ec);
+    if (FAILED(result)) return result;
+  }
+  // Resolving the selected parent's end anchor calls the host as well.
+  if (!_IsLatestResponse(packet) || !candidate || _cand != candidate) return S_OK;
+  _status = response->status;
+  candidate->style() = response->style;
+  _committed = commit;
+  _pEditSessionContext = output->owner;
+  if (!_IsLatestResponse(packet)) return S_OK;
+  _UpdateLanguageBar(_status);
+  if (!_IsLatestResponse(packet)) return S_OK;
+
+  if (response->status.composing) {
+    if (!output->range) return E_UNEXPECTED;
+    const auto selectionState = output->selection;
+    const auto selectionRevision = selectionState->revision;
+    bool created = false;
+    if (!output->composition || output->terminated) {
+      com_ptr<ITfContextComposition> compositions;
+      result = output->owner->QueryInterface(IID_ITfContextComposition,
+          reinterpret_cast<void**>(&compositions));
+      if (FAILED(result) || !_IsLatestResponse(packet)) return result;
+      com_ptr<ITfComposition> composition;
+      result = compositions->StartComposition(ec, output->range, this, &composition);
+      _PromptTrace(prompt_trace::StartCreated, output->owner, composition,
+          prompt_trace::ParsedComposing | (composition ? prompt_trace::OperationTrue : 0),
+          result, response->commit.size(), response->context.preedit.str.size(), -1,
+          response->generation);
+      if (FAILED(result) || !composition) {
+        const HRESULT failure = FAILED(result) ? result : E_UNEXPECTED;
+        packet->cleanupResult = failure;
+        if (!packet->textWritten) {
+          // Async delivery must retain its own failure after Request has returned.
+          packet->stage = Stage::Failed;
+          packet->writeResult = failure;
+          packet->compositionClosed = !source->composition || source->terminated;
+        }
+        // A completed commit and its original native closure remain successful
+        // even when the following draft cannot start. A null start adds no native.
+        return failure;
+      }
+      output->composition = composition;
+      output->terminated = false;
+      // StartComposition calls the host. Abort can run before its new object
+      // is returned, so bind it to original A before testing latest again.
+      if (!_IsLatestResponse(packet)) {
+        bool closed = false;
+        result = _CloseResponseComposition(ec, composition, output, closed);
+        packet->cleanupResult = result;
+        if (FAILED(result) && packet->textWritten) packet->stage = Stage::Written;
+        return SUCCEEDED(result) ? S_FALSE : result;
+      }
+      _SetComposition(composition);
+      created = true;
+    }
+    if (!_IsLatestResponse(packet)) return S_OK;
+    if (selectionState->revision != selectionRevision) return E_UNEXPECTED;
+    if (response->config.inline_preedit) {
+      auto context = std::make_shared<weasel::Context>(response->context);
+      com_ptr<CInlinePreeditEditSession> preedit;
+      preedit.Attach(new CInlinePreeditEditSession(this, output->owner, output->composition, context, packet));
+      // Same grant and explicit owner, never another delayed shared response.
+      result = preedit->DoEditSession(ec);
+      if (FAILED(result) || !_IsLatestResponse(packet)) return result;
+    } else if (created) {
+      // A current non-inline F establishes its own caret. It does not depend
+      // on a stale selected predecessor changing the host selection for it.
+      com_ptr<ITfRange> caret;
+      result = output->range->Clone(&caret);
+      if (SUCCEEDED(result)) result = caret->Collapse(ec, TF_ANCHOR_START);
+      if (FAILED(result)) return result;
+      if (!_IsLatestResponse(packet)) return S_OK;
+      if (selectionState->revision != selectionRevision) return E_UNEXPECTED;
+      result = _SetResponseSelection(ec, output, caret);
+      if (FAILED(result) || !_IsLatestResponse(packet)) return result;
+    }
+    if (!_IsLatestResponse(packet)) return S_OK;
+  }
+  if (!_IsLatestResponse(packet) || _cand != candidate) return S_OK;
+  const HRESULT ui_result = candidate->RequestUI(packet);
+  _PromptTrace(prompt_trace::UpdateUiApplied, output->owner, output->composition,
+      response->status.composing ? prompt_trace::ParsedComposing : 0,
+      ui_result, response->commit.size(), response->context.preedit.str.size(), -1, response->generation);
+  return ui_result;
+}
