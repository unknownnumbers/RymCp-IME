+STDMETHODIMP CCandidateList::SetSelection(UINT nIndex) {
+  com_ptr<CCandidateList> keepAlive(this);
+  const auto presentation = HostActionResponse();
+  if (!presentation) return E_FAIL;
+  if (nIndex >= presentation->response->context.cinfo.candies.size())
+    return E_INVALIDARG;
+  // A host may echo the already acknowledged selection from UpdateUIElement.
+  if (presentation->response->context.cinfo.highlighted == nIndex) return S_OK;
+  return _tsf->_DispatchCandidateAction(presentation, nIndex, false);
+}
+
+STDMETHODIMP CCandidateList::Finalize(void) {
+  com_ptr<CCandidateList> keepAlive(this);
+  const auto presentation = HostActionResponse();
+  if (!presentation || presentation->response->context.cinfo.candies.empty())
+    return E_FAIL;
+  const auto displayed_request = _desired.lock();
+  const auto intent = presentation->outputIntent.lock();
+  const HRESULT selected = _tsf->_DispatchCandidateAction(presentation,
+      presentation->response->context.cinfo.highlighted, true);
+  if (FAILED(selected)) return selected;
+  // A partial selection can retain the SAME intent but publish a new packet.
+  // Retire only the unchanged old request; never cancel the new remainder.
+  if (displayed_request && _desired.lock() == displayed_request) {
+    const HRESULT retired = CancelUI(intent);
+    if (FAILED(retired)) return retired;
+  }
+  return selected;
+}
