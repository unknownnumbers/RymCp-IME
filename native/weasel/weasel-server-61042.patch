+HRESULT CCandidateList::RequestUI(
+    const std::shared_ptr<response_owner::Packet>& packet) {
+  com_ptr<CCandidateList> keepAlive(this);
+  if (!packet || !packet->response) return S_FALSE;
+  if (packet->response->status.composing) {
+    if (!_tsf->_IsLatestResponse(packet)) return S_FALSE;
+    _desired = packet;
+  } else {
+    // Terminal output may have no live output intent, but still owns the
+    // latest visual retirement independently of document delivery success.
+    if (_tsf->_lastResponse != packet) return S_FALSE;
+    _desired.reset();
+  }
+  return _Advance();
+}
+
+HRESULT CCandidateList::CancelUI(
+    const std::shared_ptr<response_owner::Intent>& intent) {
+  com_ptr<CCandidateList> keepAlive(this);
+  const auto desired = _desired.lock();
+  const bool requested = intent && desired && desired->outputIntent.lock() == intent;
+  const bool registered = intent && _registeredIntent == intent;
+  if (requested) _desired.reset();
+  if (registered && _phase == Phase::Active) _phase = Phase::EndPending;
+  return _Advance();
+}
+
+HRESULT CCandidateList::EndUI() {
+  com_ptr<CCandidateList> keepAlive(this);
+  _desired.reset();
+  if (_phase == Phase::Active) _phase = Phase::EndPending;
+  return _Advance();
+}
+
+void CCandidateList::_SetData(
+    const std::shared_ptr<response_owner::Packet>& packet) {
+  auto shown_style = packet->response->style;
+  if (shown_style.inline_preedit)
+    shown_style.client_caps |= weasel::INLINE_PREEDIT_CAPABLE;
+  else
+    shown_style.client_caps &= ~weasel::INLINE_PREEDIT_CAPABLE;
+  const bool style_changed = _ui->style() != shown_style;
+  const bool refresh_style_only = style_changed &&
+      _ui->ctx() == packet->response->context &&
+      _ui->status() == packet->response->status;
+  if (style_changed) _ui->style() = shown_style;
+  _ui->Update(packet->response->context, packet->response->status);
+  if (_IsDesired(packet) && refresh_style_only) _ui->Refresh();
+}
+
+HRESULT CCandidateList::_EnsurePopupWindow(
+    const std::shared_ptr<response_owner::Packet>& packet) {
+  if (!_pbShow || _ui->HasWindow()) return S_OK;
+  const auto phase = _phase;
+  const auto manager = _uiElementManager;
+  const DWORD id = uiid;
+  const auto output = packet ? packet->outputIntent.lock() : nullptr;
+  const auto current = [&]() {
+    return (phase == Phase::Beginning || phase == Phase::Active) &&
+        _phase == phase && manager && _uiElementManager == manager && uiid == id &&
+        output && output->owner && _registeredIntent == output && _IsDesired(packet);
+  };
+  if (!current()) return S_FALSE;
+  // A new physical window has no acknowledged position, even when its
+  // native UIElement registration and candidate publication remain current.
+  _positioned = false;
+  com_ptr<ITfContextView> view;
+  HWND parent = nullptr;
+  HRESULT result = output->owner->GetActiveView(&view);
+  if (!current()) return S_FALSE;
+  if (FAILED(result)) return result;
+  if (!view) return E_UNEXPECTED;
+  result = view->GetWnd(&parent);
+  if (!current()) return S_FALSE;
+  if (FAILED(result)) return result;
+  // S_OK/null is a legitimate windowless view, not foreground-window fallback.
+  if (!_ui->Create(parent)) return E_FAIL;
+  if (!current()) return S_FALSE;
+  _ui->Refresh();
+  if (!current()) return S_FALSE;
+  return _ui->HasWindow() ? S_OK : E_FAIL;
+}
+
+HRESULT CCandidateList::_BeginRegistration(
+    const std::shared_ptr<response_owner::Packet>& packet) {
+  // Beginning covers QI, native Begin and HWND creation, not just the call.
+  _phase = Phase::Beginning;
+  _positioned = false;
+  _published.reset();
+  const auto output = packet->outputIntent.lock();
+  _registeredIntent = output;
+  const auto abandon = [this, output](HRESULT result) {
+    if (_registeredIntent == output) _registeredIntent.reset();
+    _phase = Phase::Idle;
+    return result;
+  };
+  if (!_IsDesired(packet) || !output || !output->owner) return abandon(S_FALSE);
+  const auto thread = _tsf->_GetThreadMgr();
+  com_ptr<ITfUIElementMgr> manager;
+  HRESULT result = thread ? thread->QueryInterface(&manager) : E_UNEXPECTED;
+  if (FAILED(result)) return abandon(result);
+  if (!_IsDesired(packet)) return abandon(S_FALSE);
+  // Host Begin callbacks may inspect GetCount/GetString immediately.
+  _SetData(packet);
+  if (!_IsDesired(packet)) return abandon(S_FALSE);
+  if (!_ui->uiCallback()) {
+    _ui->SetUICallBack([this](size_t* const sel, size_t* const hov,
+                            bool* const next, bool* const scroll_next) {
+      if (_tsf->_cand.p == this)
+        _tsf->HandleUICallback(sel, hov, next, scroll_next);
+    });
+  }
+  DWORD created_id = static_cast<DWORD>(-1);
+  BOOL created_show = TRUE;
+  {
+    struct NotifyScope {
+      CCandidateList* list;
+      ~NotifyScope() { list->_publishing.reset(); }
+    } scope{this};
+    _publishing = packet;
+    result = manager->BeginUIElement(this, &created_show, &created_id);
+  }
+  if (FAILED(result)) return abandon(result);
+  _uiElementManager = manager;
+  uiid = created_id;
+  _pbShow = created_show;
+  if (!_IsDesired(packet)) {
+    _phase = Phase::EndPending;
+    return S_FALSE;
+  }
+  result = _EnsurePopupWindow(packet);
+  if (result != S_OK) {
+    // Begin succeeded on this captured manager/id, so it still owns End.
+    _phase = Phase::EndPending;
+    return result;
+  }
+  _phase = _IsDesired(packet) ? Phase::Active : Phase::EndPending;
+  return _phase == Phase::Active ? S_OK : S_FALSE;
+}
+
+HRESULT CCandidateList::_EndRegistration() {
+  // Only EndPending reaches here. Ending suppresses nested End attempts.
+  _phase = Phase::Ending;
+  _positioned = false;
+  _published.reset();
+  _publishing.reset();
+  Show(FALSE);
+  _DisposeUIWindow();
+  const HRESULT result = _uiElementManager->EndUIElement(uiid);
+  if (FAILED(result)) {
+    _phase = Phase::EndPending;
+    return result;
+  }
+  _registeredIntent.reset();
+  _ui->Update(Context(), Status());
+  _uiElementManager.Release();
+  uiid = static_cast<DWORD>(-1);
+  _pbShow = TRUE;
+  // Deactivate clears the ThreadMgr before DestroyAll. Keep the old manager
+  // until End succeeds, then release the full old window resources.
+  if (_tsf->_cand.p != this || !_tsf->_GetThreadMgr()) _DisposeUIWindowAll();
+  _phase = Phase::Idle;
+  return result;
+}
+
+HRESULT CCandidateList::_Publish(
+    const std::shared_ptr<response_owner::Packet>& packet) {
+  PresentationScope scope(this, PresentationExit::CallerReconciles);
+  // Staging new cache contents does not acknowledge a native notification.
+  _published.reset();
+  const auto output = packet->outputIntent.lock();
+  const auto registered = _registeredIntent;
+  const bool same_owner = registered && output &&
+      response_owner::SameIdentity(registered->owner, output->owner);
+  if (!_IsDesired(packet)) return S_FALSE;
+  if (!same_owner) {
+    _phase = Phase::EndPending;
+    return S_FALSE;
+  }
+  _SetData(packet);
+  if (!_IsDesired(packet) || _phase != Phase::Active) return S_FALSE;
+  _registeredIntent = output;
+  const HRESULT window = _EnsurePopupWindow(packet);
+  if (!_IsDesired(packet) || _phase != Phase::Active) return S_FALSE;
+  // Missing physical UI does not invalidate this existing native id. One
+  // failed Create returns to the caller; no End/Begin or retry loop here.
+  if (window != S_OK) return window;
+  // Upstream9e304: every valid registration gets its update notification,
+  // including native-popup mode. Its callback may replace or cancel packet.
+  HRESULT result;
+  {
+    struct NotifyScope {
+      CCandidateList* list;
+      ~NotifyScope() { list->_publishing.reset(); }
+    } scope{this};
+    _publishing = packet;
+    result = _uiElementManager->UpdateUIElement(uiid);
+  }
+  if (!_IsDesired(packet) || _phase != Phase::Active) return S_FALSE;
+  if (SUCCEEDED(result)) {
+    _published = packet;
+    Show(_pbShow);
+  } else {
+    Show(FALSE);
+  }
+  return result;
+}
+
+HRESULT CCandidateList::_Advance() {
+  if (_uiUpdateDepth || _phase == Phase::Beginning || _phase == Phase::Ending)
+    return S_FALSE;
+  HRESULT result = S_OK;
+  for (;;) {
+    auto packet = _desired.lock();
+    if (packet && !_IsDesired(packet)) {
+      _desired.reset();
+      packet.reset();
+    }
+    if (_phase == Phase::EndPending) {
+      result = _EndRegistration();
+      if (FAILED(result)) return result;
+      continue;
+    }
+    if (_phase == Phase::Idle) {
+      if (!packet) {
+        if (_tsf->_cand.p != this || !_tsf->_GetThreadMgr()) _DisposeUIWindowAll();
+        return result;
+      }
+      result = _BeginRegistration(packet);
+      if (FAILED(result)) {
+        // A post-Begin HWND failure still owns the successful native id.
+        if (_phase == Phase::EndPending) {
+          const HRESULT ended = _EndRegistration();
+          if (FAILED(ended)) return ended;
+        }
+        if (_desired.lock() != packet) continue;
+        return result;
+      }
+      if (_phase == Phase::Idle && _desired.lock() == packet) return result;
+      continue;
+    }
+    if (!packet) {
+      _phase = Phase::EndPending;
+      continue;
+    }
+    result = _Publish(packet);
+    // This outer boundary owns the pending End/newest-content work.
+    // Nested requests only replaced desired while Update was on the stack.
+    if (_phase == Phase::EndPending || !_IsDesired(packet)) continue;
+    // The notification is now acknowledged and UpdateDepth has unwound.
+    // Position READs can bind to the actual presented packet, not a future UI.
+    if (SUCCEEDED(result) && _published.lock() == packet)
+      _tsf->_UpdateCompositionWindow(packet);
+    return result;
+  }
+}
+
+HRESULT CCandidateList::UpdateDocumentFocus(ITfDocumentMgr* focused) {
+  com_ptr<CCandidateList> keepAlive(this);
+  auto packet = PresentedResponse();
+  HRESULT result = S_OK;
+  // A captured response may invalidate the old desired packet before its
+  // replacement reaches RequestUI. Reconcile that state on this entry too.
+  if (!packet) {
+    result = _Advance();
+    if (FAILED(result)) return result;
+    packet = PresentedResponse();
+    if (!packet) return result;
+  }
+  {
+    PresentationScope scope(this, PresentationExit::CallerReconciles);
+    const auto registered = _registeredIntent;
+    const com_ptr<ITfContext> owner = registered->owner;
+    com_ptr<ITfDocumentMgr> document;
+    result = owner->GetDocumentMgr(&document);
+    if (SUCCEEDED(result) && _IsDesired(packet)) {
+      const bool same = response_owner::SameIdentity(document, focused);
+      if (_IsDesired(packet) && _phase == Phase::Active) Show(same && _pbShow);
+    }
+  }
+  if (_phase == Phase::EndPending || !_IsDesired(packet)) return _Advance();
+  return result;
+}
+
+void CCandidateList::UpdateStyle(const UIStyle& sty) { _ui->style() = sty; }
+
+bool CCandidateList::HasInputPosition(
+    const std::shared_ptr<response_owner::Packet>& packet) const {
+  return _positioned && PresentedResponse() == packet;
+}
+
+HRESULT CCandidateList::UpdateInputPosition(
+    const std::shared_ptr<response_owner::Packet>& packet, const RECT& rect) {
+  PresentationScope scope(this);
+  if (PresentedResponse() != packet) return S_FALSE;
+  _ui->UpdateInputPosition(rect);
+  if (PresentedResponse() != packet) return S_FALSE;
+  _positioned = true;
+  return Show(_pbShow);
+}
+
+void CCandidateList::Destroy() { EndUI(); }
+void CCandidateList::DestroyAll() {
+  EndUI();
+  if (!_uiUpdateDepth && _phase == Phase::Idle) _DisposeUIWindowAll();
+}
+
+UIStyle& CCandidateList::style() { return _style; }
+com_ptr<ITfContext> CCandidateList::GetContextDocument() {
+  const auto registered = _registeredIntent;
+  return registered ? registered->owner : nullptr;
+}
+
+void CCandidateList::_DisposeUIWindow() { _ui->Destroy(); }
+void CCandidateList::_DisposeUIWindowAll() {
+  PresentationScope scope(this, PresentationExit::Disposing);
+  _ui->Destroy(true);
+}
+
+void WeaselTSF::_DeleteCandidateList() {
+  _cand->Destroy();
+}
+
+HRESULT WeaselTSF::_DispatchCandidateAction(
+    const std::shared_ptr<response_owner::Packet>& presentation,
+    size_t index, bool select) {
+  if (!presentation || _cand->HostActionResponse() != presentation)
+    return E_UNEXPECTED;
+  if (index >= presentation->response->context.cinfo.candies.size())
+    return E_INVALIDARG;
+  if (!select && presentation->response->context.cinfo.highlighted == index)
+    return S_OK;
+  const auto intent = presentation->outputIntent.lock();
+  auto packet = _PrepareResponse(intent->owner);
+  if (packet->stage == response_owner::Stage::UnsupportedEndpoint ||
+      packet->source != intent) {
+    if (_producerResponse == packet) _producerResponse.reset();
+    if (packet->source && packet->source->cancelled)
+      _AbortComposition(false, packet->source);
+    if (_deferredResponseFocus) {
+      _deferredResponseFocus = false;
+      OnSetThreadFocus();
+    }
+    return FAILED(packet->captureResult) ? packet->captureResult : E_UNEXPECTED;
+  }
+  if (!_BeginResponse(packet)) return E_UNEXPECTED;
+  if (select) {
+    // Exactly one select command. Its legacy return is not an ACK; the
+    // existing Select key transaction retrieves the resulting commit body.
+    m_client.SelectCandidateOnCurrentPage(index);
+    m_client.ProcessKeyEvent(weasel::KeyEvent(ibus::Select, 0));
+  } else {
+    // The server also returns zero for Highlight; inspect its captured body.
+    m_client.HighlightCandidateOnCurrentPage(index);
+  }
+  _CaptureResponse(packet);
+  if (FAILED(packet->captureResult)) return packet->captureResult;
+  if (!select && (!packet->response->status.composing ||
+      packet->response->context.cinfo.highlighted != index)) return E_FAIL;
+  return S_OK;
+}
+
+void WeaselTSF::_SelectCandidateOnCurrentPage(size_t index) {
+  const auto presentation = _cand->PresentedResponse();
+  if (presentation) _DispatchCandidateAction(presentation, index, true);
+}
+
+void WeaselTSF::_HandleMousePageEvent(bool* const nextPage,
+                                      bool* const scrollNextPage) {
+  _PromptTrace(prompt_trace::MousePageBegin, _pEditSessionContext, _pComposition);
+  if (!_cand->CanActOnCandidates()) return;
+  auto source = _cand->RegisteredIntent();
+  if (!source || source->cancelled) return;
+  auto packet = _PrepareResponse(source->owner);
+  if (packet->stage == response_owner::Stage::UnsupportedEndpoint) {
+    if (_producerResponse == packet) _producerResponse.reset();
+    return;
+  }
+  if (!_BeginResponse(packet)) return;
+  // from scrolling event
+  if (scrollNextPage) {
+    if (_cand->style().paging_on_scroll)
+      m_client.ChangePage(!(*scrollNextPage));
+    else {
+      UINT current_select = 0, cand_count = 0;
+      _cand->GetSelection(&current_select);
+      _cand->GetCount(&cand_count);
+      bool is_reposition = _cand->GetIsReposition();
+      int offset = *scrollNextPage ? 1 : -1;
+      offset = offset * (is_reposition ? -1 : 1);
+      int index = (int)current_select + offset;
+      if (index >= 0 && index < (int)cand_count)
+        m_client.HighlightCandidateOnCurrentPage((size_t)index);
+      else {
+        KeyEvent ke{0, 0};
+        ke.keycode = (index < 0) ? ibus::Up : ibus::Down;
+        m_client.ProcessKeyEvent(ke);
+      }
+    }
+  } else {  // from click event
+    m_client.ChangePage(!(*nextPage));
+  }
+  _CaptureResponse(packet);
+  _PromptTrace(prompt_trace::MousePageReturned, source->owner, source->composition);
+}
+
+void WeaselTSF::_HandleMouseHoverEvent(const size_t index) {
+  const auto presentation = _cand->PresentedResponse();
+  if (!presentation) return;
+  const auto intent = presentation->outputIntent.lock();
+  _PromptTrace(prompt_trace::MouseHoverBegin, intent->owner, intent->composition);
+  _DispatchCandidateAction(presentation, index, false);
+  _PromptTrace(prompt_trace::MouseHoverReturned, intent->owner, intent->composition);
+}
+
+void WeaselTSF::HandleUICallback(size_t* const sel,
+                                 size_t* const hov,
+                                 bool* const next,
+                                 bool* const scroll_next) {
+  if (sel)
+    _SelectCandidateOnCurrentPage(*sel);
+  else if (hov)
+    _HandleMouseHoverEvent(*hov);
+  else if (next || scroll_next)
+    _HandleMousePageEvent(next, scroll_next);
+}
