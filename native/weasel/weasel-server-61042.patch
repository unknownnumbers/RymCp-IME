+bool CCandidateList::_IsDesired(
+    const std::shared_ptr<response_owner::Packet>& packet) const {
+  return packet && packet->response && packet->response->status.composing &&
+      _desired.lock() == packet && _tsf->_IsLatestResponse(packet);
