+CCandidateList::CCandidateList(com_ptr<WeaselTSF> pTextService)
+    : _ui(make_unique<UI>()), _tsf(pTextService), _pbShow(TRUE) {
+  _cRef = 1;
+  // Each copied callback owns only its active message's snapshot and lease.
+  // The UI-stored factory captures raw this, never a persistent strong cycle.
+  _ui->SetWindowDispatchCallback(
+      [this, before = PresentationState{}](bool entering) mutable {
+        if (entering) {
+          AddRef();
+          before = _EnterPresentation();
+          return;
+        }
+        com_ptr<CCandidateList> lease;
+        lease.Attach(this); // Adopt this dispatch's entry AddRef.
+        _LeavePresentation(before, PresentationExit::Reconcile);
+      });
+}
+
+CCandidateList::~CCandidateList() {
+  // A destructor-triggered DestroyWindow must not AddRef a zero-ref object.
+  _ui->SetWindowDispatchCallback({});
+  _ui->SetUICallBack({});
+}
+
+CCandidateList::PresentationScope::PresentationScope(
+    CCandidateList* owner, PresentationExit policy)
+    : _owner(owner), _before(owner->_EnterPresentation()), _policy(policy) {}
+
+CCandidateList::PresentationScope::~PresentationScope() {
+  _owner->_LeavePresentation(_before, _policy);
+}
+
+CCandidateList::PresentationState CCandidateList::_EnterPresentation() {
+  ++_uiUpdateDepth;
+  return {_desired.lock(), _phase};
+}
+
+void CCandidateList::_LeavePresentation(const PresentationState& before,
+    PresentationExit policy) {
+  --_uiUpdateDepth;
+  if (_uiUpdateDepth || policy == PresentationExit::CallerReconciles) return;
+  const auto desired = _desired.lock();
+  const bool pending = desired != before.desired || _phase != before.phase ||
+      (_phase == Phase::Active && !_IsDesired(desired));
+  if (pending) _Advance();
+  // Destroy(true)'s own exit must not recursively call Destroy(true).
+  if (policy == PresentationExit::Reconcile && _phase == Phase::Idle &&
+      (_tsf->_cand.p != this || !_tsf->_GetThreadMgr()))
+    _DisposeUIWindowAll();
+}
