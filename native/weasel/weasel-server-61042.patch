+void WeaselTSF::_CaptureResponse(const std::shared_ptr<response_owner::Packet>& packet,
+    const weasel::KeyEventOutcome* keyOutcome) {
+  using namespace response_owner;
+  const com_ptr<CCandidateList> candidate = _cand;
+  auto response = std::make_shared<Response>();
+  response->generation = m_client.ResponseGeneration();
+  response->status = _status;
+  if (candidate) response->style = candidate->style();
+  weasel::ResponseParser parser(&response->commit, &response->context,
+      &response->status, &response->config, &response->style);
+  const bool valid = (!keyOutcome || keyOutcome->bodyReceived) && response->generation != 0 &&
+      m_client.GetResponseData(std::ref(parser));
+  const HRESULT captureFailure = keyOutcome && keyOutcome->error != ERROR_SUCCESS ?
+      HRESULT_FROM_WIN32(keyOutcome->error) : E_FAIL;
+  packet->response = response;
+  if (packet->source) packet->source->preparing = false;
+  if (_producerResponse == packet) _producerResponse.reset();
+  _PromptTrace(prompt_trace::UpdateParsed, packet->source ? packet->source->owner.p : nullptr,
+      packet->source ? packet->source->composition.p : nullptr,
+      (valid ? prompt_trace::OperationTrue : 0) |
+      (valid && response->status.composing ? prompt_trace::ParsedComposing : 0) |
+      (valid && response->config.inline_preedit ? prompt_trace::ParsedInline : 0),
+      valid ? S_OK : captureFailure,
+      response->commit.size(), response->context.preedit.str.size(), -1, response->generation);
+  if (!valid) {
+    packet->stage = Stage::Failed;
+    packet->captureResult = captureFailure;
+    if (packet->source) packet->source->captureFailed = true;
+    if (packet->source) {
+      // End only this failed source. Its unknown response is not a standing
+      // exemption from future draft cancellation or a new context's Clear.
+      _AbortComposition(false, packet->source);
+      if (_responseIntent == packet->source) _responseIntent.reset();
+    }
+    if (_deferredResponseFocus) {
+      _deferredResponseFocus = false;
+      OnSetThreadFocus();
+    }
+    return;
+  }
+  packet->captureResult = S_OK;
+  // Preserve the existing immediate Caps-Lock decision and the latest parsed
+  // style baseline even when this document's edit grant is asynchronous.
+  if (_lastResponse == packet) {
+    _committed = !response->commit.empty();
+    _status = response->status;
+    if (candidate && _cand == candidate) candidate->style() = response->style;
+  }
+  com_ptr<ITfComposition> retiredEmptyMirror;
+  packet->outputIntent = packet->source;
+  // Abort may have happened while a prepared source was being queried. Copy
+  // the true response first, then clear only that still-owned engine draft.
+  if (packet->source && packet->source->cancelled &&
+      _engineResponseIntent.lock() == packet->source) {
+    m_client.ClearComposition();
+    _engineResponseIntent.reset();
+    if (_lastResponse == packet && (!_responseIntent || _responseIntent == packet->source))
+      _status.composing = false;
+  }
+  if (response->commit.empty()) {
+    packet->stage = Stage::NoCommit;
+    if (!response->status.composing && packet->source) {
+      const auto source = packet->source;
+      const bool wasCurrent = _responseIntent == source;
+      std::shared_ptr<Packet> dependency;
+      packet->kind = WorkKind::EndDraft;
+      packet->stage = Stage::Closing;
+      if (source->composition && !source->terminated) {
+        packet->endComposition = source->composition;
+        packet->endRange = source->range;
+        packet->clearRange = true;
+        source->nativeWork = packet;
+        dependency = packet;
+      } else dependency = NativeDependency(source->predecessor);
+      // Retire at capture, before an unhandled key reaches the application.
+      // Its subsequent raw insertion can never expand a future draft anchor.
+      source->valid = false;
+      if (wasCurrent) _responseIntent.reset();
+      if (source->composition && _IsCurrentComposition(source->composition))
+        retiredEmptyMirror.Attach(_pComposition.Detach());
+      if (_engineResponseIntent.lock() == source) _engineResponseIntent.reset();
+      const auto bridge = dependency ? _EnsureDependencyBridge(dependency) : nullptr;
+      if (wasCurrent && !_responseIntent && bridge) _responseIntent = bridge;
+      packet->outputIntent = bridge;
+    }
+  } else if (!packet->source) {
+    packet->stage = Stage::UnsupportedEndpoint;
+    packet->captureResult = E_INVALIDARG;
+  } else {
+    auto source = packet->source;
+    source->hasCommit = true;
+    source->nativeWork = packet;
+    packet->stage = source->range ? Stage::Ready : Stage::AwaitEndpoint;
+    if (_responseIntent == source) {
+      auto next = std::make_shared<Intent>();
+      next->token = ++_nextResponseIntent;
+      next->owner = source->owner;
+      next->clientId = source->clientId;
+      next->selection = source->selection;
+      next->initialSelection = false;
+      next->valid = source->valid;
+      next->cancelled = source->cancelled;
+      next->predecessor = packet;
+      next->followsCommit = true;
+      packet->outputIntent = next;
+      _responseIntent = next;
+      _engineResponseIntent = next;
+      _responseIntents.emplace_back(next);
+    }
+  }
+  // A response is already immutable before RequestEditSession can reenter.
+  _QueueResponse(packet);
+  if (!response->status.composing && _lastResponse == packet &&
+      candidate && _cand == candidate) {
+    // Empty presentation does not await document delivery. Selected text may
+    // still fail its grant; that must not leave the engine's old popup alive.
+    _UpdateLanguageBar(_status);
+    if (_lastResponse == packet && _cand == candidate)
+      candidate->RequestUI(packet);
+  }
+  if (_deferredResponseFocus) {
+    _deferredResponseFocus = false;
+    OnSetThreadFocus();
+  }
+}
+
+class CResponseEditSession : public CEditSession {
+ public:
+  CResponseEditSession(com_ptr<WeaselTSF> service,
+      const std::shared_ptr<response_owner::Packet>& packet)
+      : CEditSession(service, packet->source->owner), packet_(packet) {}
+  STDMETHODIMP DoEditSession(TfEditCookie ec) override {
+    return _pTextService->_DeliverResponse(packet_, ec);
+  }
+ private:
+  std::shared_ptr<response_owner::Packet> packet_;
+};
+
+void WeaselTSF::_QueueResponse(const std::shared_ptr<response_owner::Packet>& packet) {
+  using namespace response_owner;
+  if (!packet || packet->scheduled || packet->stage == Stage::Failed ||
+      packet->stage == Stage::UnsupportedEndpoint) return;
+  if (packet->kind == WorkKind::Content && !packet->response) return;
+  packet->scheduled = true;
+  if (packet->kind == WorkKind::EndDraft && !packet->endComposition) {
+    // Logical retirement and empty UI need no document lock. Any outstanding
+    // selected P is independently retained by its dependency bridge.
+    packet->compositionClosed = true;
+    packet->cleanupResult = S_OK;
+    packet->stage = Stage::Done;
+    return;
+  }
+  if (!packet->source || !packet->source->owner) {
+    if (packet->kind == WorkKind::Content && packet->stage == Stage::NoCommit &&
+        _lastResponse == packet && !_responseIntent) {
+      _status = packet->response->status;
+      _UpdateLanguageBar(_status);
+    }
+    return;
+  }
+  com_ptr<CResponseEditSession> session;
+  session.Attach(new CResponseEditSession(this, packet));
+  const auto response = packet->response;
+  _PromptTrace(prompt_trace::UpdateQueued, packet->source->owner,
+      packet->source->composition, 0, S_OK, response ? response->commit.size() : 0,
+      response ? response->context.preedit.str.size() : 0, -1,
+      response ? response->generation : 0);
+  HRESULT granted = E_FAIL;
+  const DWORD flags = TF_ES_READWRITE |
+      (packet->deferNative ? TF_ES_ASYNC : TF_ES_ASYNCDONTCARE);
+  const HRESULT requested = packet->source->owner->RequestEditSession(packet->source->clientId,
+      session, flags, &granted);
+  _PromptTrace(prompt_trace::UpdateRequestResult, packet->source->owner,
+      packet->source->composition, 0, requested);
+  _PromptTrace(prompt_trace::UpdateGrantResult, packet->source->owner,
+      packet->source->composition, 0, granted);
+  if (FAILED(requested) || FAILED(granted)) {
+    const HRESULT failed = FAILED(requested) ? requested : granted;
+    if (packet->stage != Stage::Written && packet->stage != Stage::Done) {
+      packet->stage = Stage::Failed;
+      packet->writeResult = failed;
+      packet->cleanupResult = failed;
+      const com_ptr<ITfComposition> native = packet->kind == WorkKind::EndDraft ?
+          packet->endComposition : packet->source->composition;
+      if (native) {
+        com_ptr<ITfRange> observed;
+        const HRESULT observation = native->GetRange(&observed);
+        if (observation == E_UNEXPECTED) {
+          packet->compositionClosed = true;
+          if (packet->source->composition.p == native.p)
+            packet->source->terminated = true;
+        }
+      } else if (!packet->source->predecessor)
+        packet->compositionClosed = true;
+      if (packet->kind == WorkKind::Content) _RetireRejectedEmptyUi(packet);
+    }
+  }
+}
+
+
+void WeaselTSF::_RetireRejectedEmptyUi(
+    const std::shared_ptr<response_owner::Packet>& packet) {
+  // A failed grant, or a written commit whose closed composition could not
+  // finish another cleanup step, may retire the same context's empty UI.
+  // This never changes the delivery stage/error or writes document text.
+  if (!packet || !packet->response || !packet->source) return;
+  const bool rejectedEmpty = packet->stage == response_owner::Stage::Failed &&
+      packet->response->commit.empty();
+  const bool writtenClosed = packet->stage == response_owner::Stage::Written &&
+      packet->textWritten && packet->compositionClosed;
+  if ((!rejectedEmpty && !writtenClosed) || packet->response->status.composing ||
+      !packet->response->context.preedit.str.empty() ||
+      !packet->response->context.cinfo.candies.empty()) return;
+  auto current = [this, packet]() {
+    if (!_IsLatestResponse(packet) || _IsComposing()) return false;
+    const bool same = response_owner::SameIdentity(
+        _pEditSessionContext, packet->source->owner);
+    // QueryInterface in SameIdentity can reenter the host.
+    return same && _IsLatestResponse(packet) && !_IsComposing();
+  };
+  if (!current()) return;
+  const HRESULT ui_result = _cand->RequestUI(packet);
+  if (current())
+    _PromptTrace(prompt_trace::UpdateUiApplied, packet->source->owner,
+        packet->source->composition, 0, ui_result, packet->response->commit.size(),
+        0, -1, packet->response->generation);
+}
+
+bool WeaselTSF::_IsLatestResponse(const std::shared_ptr<response_owner::Packet>& packet) {
+  auto output = packet->outputIntent.lock();
+  return _lastResponse == packet && output && output == _responseIntent &&
+         output->valid && !output->cancelled;
+}
+
+std::shared_ptr<response_owner::Intent> WeaselTSF::_FindResponseIntent(ITfComposition* composition) {
+  if (!composition) return nullptr;
+  const auto intents = _responseIntents;
+  for (const auto& intent : intents) {
+    if (intent && response_owner::SameIdentity(intent->composition, composition)) return intent;
+  }
+  return nullptr;
+}
+
+void WeaselTSF::_InvalidateResponse(ITfContext* owner, bool cancel) {
+  const auto intents = _responseIntents;
+  std::vector<std::shared_ptr<response_owner::Intent>> matched;
+  std::vector<std::shared_ptr<response_owner::SelectionState>> states;
+  for (const auto& intent : intents) {
+    if (!intent || (owner && !response_owner::SameIdentity(intent->owner, owner))) continue;
+    matched.push_back(intent);
+    intent->valid = false;
+    if (cancel) intent->cancelled = true;
+    if (std::find(states.begin(), states.end(), intent->selection) == states.end()) {
+      states.push_back(intent->selection);
+      intent->selection->Revoke();
+    }
+  }
+  // Revoke every old selection lease before a COM Release can activate B.
+  for (const auto& intent : matched) intent->ownSelection.Release();
+}
+
+void WeaselTSF::_ResponseTerminated(ITfComposition* composition) {
+  // This precedes the current-composition early return: SetText can have
+  // already installed a replacement B while A's callback is delivered.
+  const auto intents = _responseIntents;
+  for (const auto& intent : intents) {
+    if (!intent) continue;
+    const com_ptr<ITfComposition> captured = intent->composition;
+    const bool same = response_owner::SameIdentity(captured, composition);
+    if (same && intent->composition.p == captured.p) {
+      intent->terminated = true;
+      const auto work = intent->nativeWork.lock();
+      if (work && work->source == intent) work->compositionClosed = true;
+    }
+  }
+}
+
+HRESULT WeaselTSF::_SetResponseSelection(TfEditCookie ec,
+    const std::shared_ptr<response_owner::Intent>& intent, ITfRange* range,
+    const TF_SELECTIONSTYLE* style) {
+  if (!intent || !range) return E_INVALIDARG;
+  const auto state = intent->selection;
+  // Operation leaves the active slot before any local COM reference releases.
+  com_ptr<ITfRange> expected, published, retired;
+  response_owner::SelectionOperation operation(*state, intent.get());
+  const auto revision = state->revision;
+  // Publish only this call's completed clone. A nested selection operation
+  // revokes this call rather than receiving a late out value into its cell.
+  HRESULT result = range->Clone(&expected);
+  if (FAILED(result)) return result;
+  if (!expected || state->revision != revision) return E_UNEXPECTED;
+  published = expected;
+  if (state->revision != revision) return E_UNEXPECTED;
+  retired.Attach(intent->ownSelection.Detach());
+  intent->ownSelection.Attach(published.Detach());
+  operation.expected = expected;
+  TF_SELECTION selection = {};
+  selection.range = range;
+  if (style) selection.style = *style;
+  else selection.style.ase = TF_AE_NONE;
+  result = intent->owner->SetSelection(ec, 1, &selection);
+  if (FAILED(result) || operation.revoked) {
+    if (intent->ownSelection.p == expected.p) intent->ownSelection.Release();
+    return FAILED(result) ? result : E_UNEXPECTED;
+  }
+  return result;
+}
+
+bool WeaselTSF::_ObserveResponseSelection(ITfContext* owner, TfEditCookie ec) {
+  bool own = false;
+  const response_owner::Intent* acknowledgedIntent = nullptr;
+  ITfRange* acknowledgedRange = nullptr;
+  const auto intents = _responseIntents;
+  std::vector<std::shared_ptr<response_owner::SelectionState>> states;
+  std::vector<response_owner::SelectionOperation*> operations;
+  for (const auto& intent : intents) {
+    if (!intent) continue;
+    const auto state = intent->selection;
+    auto operation = state->active;
+    if (!response_owner::SameIdentity(intent->owner, owner)) continue;
+    if (std::find(states.begin(), states.end(), state) == states.end()) {
+      states.push_back(state);
+      operations.push_back(operation);
+    }
+  }
+  // Every TSF-visible change is a revision, including our own notification.
+  // ownSelection below acknowledges cancellation only; it is not an epoch.
+  for (const auto& state : states) {
+    state->Notify();
+  }
+  TF_SELECTION selection = {};
+  ULONG count = 0;
+  if (owner->GetSelection(ec, TF_DEFAULT_SELECTION, 1, &selection, &count) == S_OK && count == 1) {
+    for (const auto& intent : intents) {
+      if (!intent || !response_owner::SameIdentity(intent->owner, owner) || !intent->ownSelection) continue;
+      // Host comparisons may reenter focus cancellation or publish a newer
+      // expected selection. Keep this range alive without consuming that one.
+      com_ptr<ITfRange> expected = intent->ownSelection;
+      // A selected commit may deliver after focus cancellation. Its exact
+      // selection notification remains ours; draft eligibility is separate.
+      auto current = [&]() {
+        return intent->ownSelection.p == expected.p;
+      };
+      if (!current()) continue;
+      LONG start = 1, end = 1;
+      own = expected->CompareStart(ec, selection.range, TF_ANCHOR_START, &start) == S_OK &&
+            current() &&
+            expected->CompareEnd(ec, selection.range, TF_ANCHOR_END, &end) == S_OK &&
+            current() &&
+            start == 0 && end == 0;
+      if (own) {
+        acknowledgedIntent = intent.get();
+        acknowledgedRange = expected;
+      }
+      if (current()) intent->ownSelection.Release();
+      if (own) break;
+    }
+    selection.range->Release();
+  }
+  for (size_t index = 0; index < states.size(); ++index) {
+    const auto& state = states[index];
+    auto operation = operations[index];
+    // The callback may acknowledge only the operation that was active before
+    // its COM comparisons, is still active, and still owns this exact expected
+    // range. A newer operation is never acknowledged by an older notification.
+    if (operation && state->active == operation &&
+        !(own && !operation->revoked && operation->intent == acknowledgedIntent &&
+          operation->expected == acknowledgedRange)) operation->revoked = true;
+  }
+  if (own) return true;
+  // Only a not-yet-anchored insertion loses its grant-time selection option.
+  // Existing captured commit ranges remain eligible for their A delivery.
+  for (const auto& intent : intents) {
+    if (intent && response_owner::SameIdentity(intent->owner, owner) && !intent->range && !intent->followsCommit)
+      intent->valid = false;
+  }
+  return false;
+}
+
+bool WeaselTSF::_ProduceKeyResponse(ITfContext* owner, const weasel::KeyEvent& key) {
+  auto packet = _PrepareResponse(owner);
+  if (packet->stage == response_owner::Stage::UnsupportedEndpoint) {
+    _PromptTrace(prompt_trace::KeyBypass, owner,
+        packet->source ? packet->source->composition.p : nullptr,
+        prompt_trace::BypassEndpoint, packet->captureResult, -1, -1, -1, 0);
+    if (_producerResponse == packet) _producerResponse.reset();
+    if (packet->source && packet->source->cancelled)
+      _AbortComposition(false, packet->source);
+    if (_deferredResponseFocus) {
+      _deferredResponseFocus = false;
+      OnSetThreadFocus();
+    }
+    // No safe old endpoint: do not forward the original key into another app.
+    return true;
+  }
+  if (!_BeginResponse(packet)) return true;
+  const auto outcome = m_client.ProcessKeyEventOutcome(key);
+  // Unknown means this write may already have reached the engine. Consume this
+  // key to avoid duplicating its possible effect through raw fallback, without
+  // calling it Handled or retrying it. A valid Unhandled header stays unhandled
+  // even if its body failed.
+  const bool consume = outcome.Handled() || outcome.state == weasel::KeyEventState::Unknown;
+  _CaptureResponse(packet, &outcome);
+  return consume;
+}
