+STDAPI CLangBarItemButton::AdviseSink(REFIID riid,
+                                      IUnknown* punk,
+                                      DWORD* pdwCookie) {
+  const com_ptr<CLangBarItemButton> keepAlive = this;
+  if (!IsEqualIID(riid, IID_ITfLangBarItemSink))
+    return CONNECT_E_CANNOTCONNECT;
+  if (_pLangBarItemSink != NULL)
+    return CONNECT_E_ADVISELIMIT;
+  com_ptr<ITfLangBarItemSink> sink;
+  if (punk->QueryInterface(IID_ITfLangBarItemSink,
+          reinterpret_cast<void**>(&sink)) != S_OK)
+    return E_NOINTERFACE;
+  // QueryInterface may have installed another subscriber on this same button.
+  if (_pLangBarItemSink) return CONNECT_E_ADVISELIMIT;
+  _pLangBarItemSink.Attach(sink.Detach());
+  *pdwCookie = LANGBARITEMSINK_COOKIE;
+  return S_OK;
+}
+
+STDAPI CLangBarItemButton::UnadviseSink(DWORD dwCookie) {
+  const com_ptr<CLangBarItemButton> keepAlive = this;
+  if (dwCookie != LANGBARITEMSINK_COOKIE || _pLangBarItemSink == NULL)
+    return CONNECT_E_NOCONNECTION;
+  com_ptr<ITfLangBarItemSink> retired;
+  retired.Attach(_pLangBarItemSink.Detach());
+  return S_OK;
+}
