+void RimeWithWeaselHandler::_RefreshModeStyle(WeaselSessionId ipc_id) {
+  auto found = m_session_status_map.find(ipc_id);
+  if (found == m_session_status_map.end() || !found->second.session_id)
+    return;
+  SessionStatus& session = found->second;
+  RIME_STRUCT(RimeStatus, status);
+  if (rime_api->get_status(session.session_id, &status)) {
+    const std::string schema_id = status.schema_id ? status.schema_id : "";
+    rime_api->free_status(&status);
+    if (session.mode_schema_id != schema_id && schema_id != ".default") {
+      _LoadSchemaSpecificSettings(ipc_id, schema_id);
+      _LoadAppInlinePreeditSet(ipc_id, true);
+      session.__synced = false;
+    }
+  }
+  if (!session.mode_option.empty()) {
+    const int state = !!rime_api->get_option(session.session_id,
+                                               session.mode_option.c_str());
+    if (ApplyModeStyle(session, state, session.style)) {
+      session.__synced = false;
+    }
+  }
+  if (m_ui && m_ui->style() != session.style) {
+    m_ui->style() = session.style;
+    // UI::Update can skip repaint when only the style changed.
+    m_ui->Refresh();
+  }
+}
