new file mode 100644
index 0000000..958db3e
--- /dev/null
+++ b/WeaselUI/JpCommentStyle.h
@@ -0,0 +1,130 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace weasel {
+namespace jp_comment {
+
+// Horizontal-text candidate rows only; not a general markup language.
+constexpr float kLabelScale = 0.65f;
+constexpr float kBaselineDrop = 0.20f;
+constexpr float kVariantScale = 0.45f;
+
+struct Label {
+  size_t position;
+  wchar_t character;
+};
+
+struct Parsed {
+  std::wstring text;
+  std::vector<Label> labels;
+};
+
+struct Variant {
+  size_t codepoint;
+  wchar_t label;
+};
+
+struct VariantHeader {
+  bool valid = false;
+  size_t length = 0;
+  std::vector<Variant> variants;
+};
+
+// A private JP presentation prefix, never candidate text or a general markup
+// protocol. Indices are unique/increasing Unicode codepoint positions.
+inline VariantHeader ParseVariantHeader(const std::wstring& source) {
+  VariantHeader result;
+  if (source.compare(0, 4, L"[jp:") != 0) return result;
+  const size_t end = source.find(L']', 4);
+  if (end == std::wstring::npos || end == 4) return result;
+  size_t cursor = 4;
+  while (cursor < end) {
+    if (source[cursor] < L'0' || source[cursor] > L'9') return VariantHeader{};
+    size_t position = 0;
+    while (cursor < end && source[cursor] >= L'0' && source[cursor] <= L'9') {
+      const size_t digit = static_cast<size_t>(source[cursor++] - L'0');
+      if (position > (static_cast<size_t>(-1) - digit) / 10) return VariantHeader{};
+      position = position * 10 + digit;
+    }
+    if (cursor >= end || source[cursor++] != L'=' || cursor >= end)
+      return VariantHeader{};
+    const wchar_t label = source[cursor++];
+    if (label != L'\u65E7' && label != L'\u7570') return VariantHeader{};
+    if (!result.variants.empty() && position <= result.variants.back().codepoint)
+      return VariantHeader{};
+    result.variants.push_back({position, label});
+    if (cursor == end) break;
+    if (source[cursor++] != L',' || cursor == end) return VariantHeader{};
+  }
+  result.valid = true;
+  result.length = end + 1;
+  return result;
+}
+
+struct CandidateLabel {
+  size_t position;
+  size_t length;
+  wchar_t label;
+};
+
+inline bool IsHan(unsigned int value) {
+  return value == 0x3007 || (value >= 0x3400 && value <= 0x4dbf) ||
+      (value >= 0x4e00 && value <= 0x9fff) ||
+      (value >= 0xf900 && value <= 0xfaff) ||
+      (value >= 0x20000 && value <= 0x2fa1f) ||
+      (value >= 0x30000 && value <= 0x3347f);
+}
+
+inline std::vector<CandidateLabel> ParseCandidate(
+    const std::wstring& schema, const std::wstring& text, const std::wstring& comment) {
+  std::vector<CandidateLabel> labels;
+  if (schema != L"jp_sela") return labels;
+  const auto header = ParseVariantHeader(comment);
+  if (!header.valid) return labels;
+  size_t point = 0, next = 0;
+  for (size_t i = 0; i < text.size() && next < header.variants.size(); ++point) {
+    const size_t start = i;
+    unsigned int value = static_cast<unsigned int>(text[i++]);
+    if (value >= 0xd800 && value <= 0xdbff && i < text.size() &&
+        text[i] >= 0xdc00 && text[i] <= 0xdfff) {
+      value = 0x10000 + ((value - 0xd800) << 10) +
+              (static_cast<unsigned int>(text[i++]) - 0xdc00);
+    }
+    if (header.variants[next].codepoint == point) {
+      if (IsHan(value)) labels.push_back({start, i - start, header.variants[next].label});
+      ++next;
+    }
+  }
+  return labels;
+}
+
+// Positions refer to the displayed UTF-16 string after removing only the
+// underscore in the two exact, schema-scoped label tokens.
+inline Parsed Parse(const std::wstring& schema, const std::wstring& raw) {
+  Parsed result;
+  if (schema != L"jp_sela") {
+    result.text = raw;
+    return result;
+  }
+  const auto header = ParseVariantHeader(raw);
+  const std::wstring source = header.valid ? raw.substr(header.length) : raw;
+  size_t copied = 0;
+  for (size_t i = 0; i + 6 <= source.size(); ++i) {
+    if (source.compare(i, 4, L" | _") != 0 || source[i + 5] != L' ' ||
+        (source[i + 4] != L'\u8A13' && source[i + 4] != L'\u97F3' &&
+         source[i + 4] != L'\u4E2D'))
+      continue;
+    result.text.append(source, copied, i + 3 - copied);
+    result.labels.push_back({result.text.size(), source[i + 4]});
+    result.text.push_back(source[i + 4]);
+    copied = i + 5;
+    i += 4;
+  }
+  result.text.append(source, copied, std::wstring::npos);
+  return result;
+}
+
+}  // namespace jp_comment
+}  // namespace weasel
