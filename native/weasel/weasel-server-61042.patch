+std::uint64_t WeaselTSF::_PromptTrace(prompt_trace::Stage stage, ITfContext* origin,
+    ITfComposition* captured, std::uint64_t flags, HRESULT result,
+    std::int64_t commit, std::int64_t preedit, int empty, std::uint64_t generation) {
+  prompt_trace::LastErrorGuard preserve;
+  try {
+  auto& recorder = prompt_trace::Get();
+  if (!recorder.Enabled()) return 0;
+  if (generation == UINT64_MAX) generation = m_client.ResponseGeneration();
+  if (generation != 0) flags |= prompt_trace::BodyValid;
+  if (_status.composing) flags |= prompt_trace::Composing;
+  if (_pComposition) flags |= prompt_trace::HasLocalComposition;
+  if (stage == prompt_trace::KeyReturned || stage == prompt_trace::MousePageReturned ||
+      stage == prompt_trace::MouseHoverReturned || stage == prompt_trace::ThreadFocusReturned) {
+    prompt_trace::Lengths lengths;
+    if (generation != 0 && m_client.GetResponseData([&](LPWSTR data, UINT count) {
+          return prompt_trace::CountBody(data, count, lengths);
+        })) { commit = lengths.commit; preedit = lengths.preedit; }
+  }
+  return recorder.Emit(stage, this, origin, _pEditSessionContext.p, captured,
+      _pComposition.p, generation, commit, preedit, flags, empty, result);
+  } catch (...) { prompt_trace::Get().Fail(); return 0; }
+}
+void WeaselTSF::_PromptTraceRange(prompt_trace::Stage stage, TfEditCookie ec,
+    ITfContext* origin, ITfComposition* captured, ITfRange* range, std::uint64_t flags) {
+  prompt_trace::LastErrorGuard preserve;
+  try {
+  if (!prompt_trace::Get().Enabled()) return;
+  BOOL empty = FALSE;
+  const HRESULT result = range ? range->IsEmpty(ec, &empty) : E_POINTER;
+  _PromptTrace(stage, origin, captured, flags, result, -1, -1,
+      result == S_OK ? (empty ? 1 : 0) : -1);
+  } catch (...) { prompt_trace::Get().Fail(); }
+}
+
+STDAPI WeaselTSF::DoEditSession(TfEditCookie) {
+  // The shared service is no longer a response consumer. Each real request
+  // owns its original context and immutable output in CResponseEditSession.
+  return E_UNEXPECTED;
+}
+
+void WeaselTSF::_PruneResponseIntents() {
+  // Move releases outside the live container. A final COM Release may reenter.
+  std::vector<std::shared_ptr<response_owner::Intent>> retained, retired;
+  for (auto& intent : _responseIntents) {
+    const bool nativeOpen = intent->composition && !intent->terminated;
+    const bool dependencyOwner = intent->valid && !intent->cancelled &&
+        response_owner::NativeDependency(intent->predecessor) != nullptr;
+    if (intent.use_count() > 1 || nativeOpen || dependencyOwner)
+      retained.push_back(std::move(intent));
+    else retired.push_back(std::move(intent));
+  }
+  _responseIntents.swap(retained);
+  retired.clear();
+}
+
+std::shared_ptr<response_owner::Packet> WeaselTSF::_FindNativeDependency(ITfContext* owner) {
+  const auto intents = _responseIntents;
+  std::shared_ptr<response_owner::Packet> result;
+  std::shared_ptr<response_owner::Intent> source;
+  std::uint64_t token = 0;
+  for (const auto& intent : intents) {
+    if (!intent || !response_owner::SameIdentity(intent->owner, owner)) continue;
+    auto work = response_owner::NativeDependency(intent->nativeWork.lock());
+    if (!work) work = response_owner::NativeDependency(intent->predecessor);
+    const bool open = intent->composition && !intent->terminated;
+    if ((work || open) && intent->token >= token) {
+      result = work;
+      source = work && work->source ? work->source : intent;
+      token = intent->token;
+    }
+  }
+  // Choose once before advancing. Multiple bridges naming one failed native
+  // must not create multiple cleanup attempts during this producer action.
+  return response_owner::CleanupForAction(source, result, false);
+}
+
+std::shared_ptr<response_owner::Intent> WeaselTSF::_EnsureDependencyBridge(
+    const std::shared_ptr<response_owner::Packet>& requested) {
+  const auto work = response_owner::NativeDependency(requested);
+  if (!work || !work->source) return nullptr;
+  // Reuse one live parent-only holder. Repeated cancellation does not retain
+  // a fresh history entry after a replacement bridge has taken ownership.
+  for (const auto& intent : _responseIntents) {
+    if (intent->valid && !intent->cancelled && intent->predecessor == work)
+      return intent;
+  }
+  auto bridge = std::make_shared<response_owner::Intent>();
+  bridge->token = ++_nextResponseIntent;
+  bridge->owner = work->source->owner;
+  bridge->clientId = work->source->clientId;
+  bridge->selection = work->source->selection;
+  bridge->predecessor = work;
+  bridge->initialSelection = true;
+  bridge->followsCommit = false;
+  _responseIntents.push_back(bridge);
+  return bridge;
+}
+
+// Read any initial empty point before IPC. After IPC there is no host callback
+// between the immutable value copy and native queue submission.
+std::shared_ptr<response_owner::Packet> WeaselTSF::_PrepareResponse(ITfContext* owner) {
+  using namespace response_owner;
+  auto packet = std::make_shared<Packet>();
+  // Establish this request before retiring anything that can Release COM.
+  // A nested B must supersede A, even if it arrives during registry pruning.
+  const auto previousLast = std::move(_lastResponse);
+  const auto previousProducer = std::move(_producerResponse);
+  _lastResponse = packet;
+  _producerResponse = packet;
+  _PruneResponseIntents();
+  if (_lastResponse != packet) {
+    packet->stage = Stage::UnsupportedEndpoint;
+    packet->captureResult = E_UNEXPECTED;
+    return packet;
+  }
+  if (owner) {
+    // A followsCommit successor keeps P as its content predecessor. Retain the
+    // newly prepared E strongly until its one native request owns it.
+    std::shared_ptr<Packet> preparedCleanup;
+    const auto makeFresh = [this, owner]() {
+      auto fresh = std::make_shared<Intent>();
+      fresh->token = ++_nextResponseIntent;
+      fresh->owner = owner;
+      fresh->clientId = _GetClientId();
+      const auto intents = _responseIntents;
+      for (const auto& intent : intents) {
+        if (intent && SameIdentity(intent->owner, owner)) {
+          fresh->selection = intent->selection;
+          break;
+        }
+      }
+      fresh->predecessor = _FindNativeDependency(owner);
+      return fresh;
+    };
+    auto source = _responseIntent;
+    const bool same = source && SameIdentity(source->owner, owner);
+    if (_lastResponse != packet) {
+      packet->stage = Stage::UnsupportedEndpoint;
+      packet->captureResult = E_UNEXPECTED;
+      return packet;
+    }
+    // A new action may advance a returned native failure using a new exact
+    // cleanup packet. Keep a successful P's end anchor on its successor.
+    if (same && source->valid && !source->cancelled && source->predecessor) {
+      const auto parent = source->predecessor;
+      const auto dependency = NativeDependency(parent);
+      if (dependency && NativeActionTerminal(dependency)) {
+        const auto cleanup = CleanupForAction(dependency->source, dependency, false);
+        if (cleanup && cleanup != dependency) {
+          preparedCleanup = cleanup;
+          if (!source->followsCommit) source->predecessor = cleanup;
+        }
+        if (_lastResponse != packet || _responseIntent != source ||
+            !source->valid || source->cancelled) {
+          packet->stage = Stage::UnsupportedEndpoint;
+          packet->captureResult = E_UNEXPECTED;
+          return packet;
+        }
+      }
+    }
+    const auto continuationNeedsFresh = [&source]() {
+      if (!source || !source->valid || source->cancelled ||
+          source->range || source->composition || source->initialPoint ||
+          source->hasCommit || source->preparing || !source->predecessor) return false;
+      const auto& parent = source->predecessor;
+      const auto dependency = NativeDependency(parent);
+      if (!dependency) {
+        if (!source->followsCommit) return true;
+        return NativeActionTerminal(parent) &&
+            (!parent->textWritten || !parent->endAnchorValid);
+      }
+      return source->followsCommit ?
+          NativeActionTerminal(parent) && (!parent->textWritten || !parent->endAnchorValid) :
+          source->initialPointResult != E_PENDING;
+    };
+    if (same && continuationNeedsFresh()) {
+      const auto parent = source->predecessor;
+      const com_ptr<ITfComposition> native = parent->source ? parent->source->composition : nullptr;
+      // Resolve owner/dependency COM while old S is still coherent.
+      auto fresh = makeFresh();
+      if (_lastResponse != packet || _responseIntent != source ||
+          source->predecessor != parent || !continuationNeedsFresh() ||
+          (parent->source && parent->source->composition.p != native.p)) {
+        packet->stage = Stage::UnsupportedEndpoint;
+        packet->captureResult = E_UNEXPECTED;
+        return packet;
+      }
+      fresh->predecessor = NativeDependency(fresh->predecessor);
+      const com_ptr<CCandidateList> candidate = _cand;
+      source->valid = false;
+      _responseIntents.push_back(fresh);
+      _responseIntent = fresh;
+      if (_engineResponseIntent.lock() == source) _engineResponseIntent = fresh;
+      packet->source = fresh;
+      if (candidate) candidate->CancelUI(source);
+      source = fresh;
+      if (_lastResponse != packet || _responseIntent != fresh ||
+          !fresh->valid || fresh->cancelled) {
+        packet->stage = Stage::UnsupportedEndpoint;
+        packet->captureResult = E_UNEXPECTED;
+        return packet;
+      }
+    } else if (!source || !same || !source->valid || source->cancelled) {
+      if (source) _AbortComposition(true, source);
+      if (_lastResponse != packet) {
+        packet->stage = Stage::UnsupportedEndpoint;
+        packet->captureResult = E_UNEXPECTED;
+        return packet;
+      }
+      source = makeFresh();
+      if (_lastResponse != packet) {
+        packet->stage = Stage::UnsupportedEndpoint;
+        packet->captureResult = E_UNEXPECTED;
+        return packet;
+      }
+      // A fresh intent never borrows the old global composition.
+      _responseIntent = source;
+      _responseIntents.push_back(source);
+    }
+    packet->source = source;
+    const auto dependency = NativeDependency(source->predecessor);
+    if (dependency && dependency->kind == WorkKind::EndDraft && !dependency->scheduled) {
+      com_ptr<ITfComposition> retiredMirror;
+      if (_IsCurrentComposition(dependency->endComposition))
+        retiredMirror.Attach(_pComposition.Detach());
+      // The new action publishes its endpoint owner before the only new close
+      // request. A refusal is terminal for this action, never a queue loop.
+      _QueueResponse(dependency);
+      if (_lastResponse != packet || _responseIntent != source ||
+          !source->valid || source->cancelled) {
+        packet->stage = Stage::UnsupportedEndpoint;
+        packet->captureResult = E_UNEXPECTED;
+        return packet;
+      }
+    }
+    _CaptureInitialPoint(packet);
+  }
+  if (packet->source && (_lastResponse != packet || _responseIntent != packet->source ||
+      !packet->source->valid || packet->source->cancelled)) {
+    packet->stage = Stage::UnsupportedEndpoint;
+    packet->captureResult = E_UNEXPECTED;
+    packet->source->preparing = false;
+  }
+  if (packet->source && packet->stage != Stage::UnsupportedEndpoint) {
+    const auto source = packet->source;
+    bool defer = source->predecessor && !source->predecessor->compositionClosed;
+    // SameIdentity may call the host. Do it before IPC, never between a
+    // captured response and its native request where nested B could overtake A.
+    for (auto frame = _responseDelivery; !defer && frame; frame = frame->previous) {
+      defer = SameIdentity(frame->source->owner, source->owner);
+      if (_lastResponse != packet || _responseIntent != source ||
+          !source->valid || source->cancelled) {
+        packet->stage = Stage::UnsupportedEndpoint;
+        packet->captureResult = E_UNEXPECTED;
+        return packet;
+      }
+    }
+    packet->deferNative = defer;
+  }
+  return packet;
+}
+
+bool WeaselTSF::_BeginResponse(const std::shared_ptr<response_owner::Packet>& packet) {
+  // This boundary immediately precedes the producer's first real engine IPC.
+  // A pre-engine READ is not yet ownership of an unread engine response.
+  if (!packet || _lastResponse != packet || packet->stage == response_owner::Stage::UnsupportedEndpoint ||
+      packet->stage == response_owner::Stage::Failed ||
+      (packet->source && (_responseIntent != packet->source ||
+       !packet->source->valid || packet->source->cancelled))) {
+    if (packet) {
+      packet->stage = response_owner::Stage::UnsupportedEndpoint;
+      packet->captureResult = E_UNEXPECTED;
+      if (_producerResponse == packet) _producerResponse.reset();
+    }
+    return false;
+  }
+  if (packet->source) {
+    packet->source->preparing = true;
+    _engineResponseIntent = packet->source;
+  }
+  return true;
+}
