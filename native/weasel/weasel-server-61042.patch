+LRESULT CALLBACK WeaselPanel::WindowDispatchProc(HWND token, UINT message,
+    WPARAM wParam, LPARAM lParam) {
+  // ATL's instance thunk replaces the first argument with its base object,
+  // as in the vendored WTL MDIFrameWindowProc. It is not a real HWND here.
+  using DispatchBase = ATL::CWindowImplBaseT<CWindow, CWeaselPanelTraits>;
+  auto self = static_cast<WeaselPanel*>(reinterpret_cast<DispatchBase*>(token));
+  auto callback = self->_windowDispatch;
+  if (!callback) return DispatchBase::WindowProc(token, message, wParam, lParam);
+  struct DispatchScope {
+    std::function<void(bool)> callback;
+    explicit DispatchScope(std::function<void(bool)> action)
+        : callback(std::move(action)) {
+      callback(true);
+    }
+    ~DispatchScope() {
+      // Owner exit may Advance and delete pimpl. Never read panel afterward.
+      callback(false);
+    }
+  } scope(std::move(callback));
+  return DispatchBase::WindowProc(token, message, wParam, lParam);
+}
