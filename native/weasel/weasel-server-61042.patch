+#include "stdafx.h"
+#include "WeaselTSF.h"
+#include "CandidateList.h"
+#include "ResponseParser.h"
+
+// A registration forwards only while its exact cell is current. The weak cell
+// prevents a service/binding/proxy cycle; the locked cell's candidate retains
+// the service throughout a forwarded call.
+class CTextEditEventSink : public ITfTextEditSink, public ITfTextLayoutSink {
+ public:
+  CTextEditEventSink(WeaselTSF* service,
+      const std::shared_ptr<WeaselTSF::TextEditBinding>& binding)
+      : service_(service), binding_(binding) {}
+  STDMETHODIMP QueryInterface(REFIID id, void** object) override {
+    if (!object) return E_POINTER;
+    *object = nullptr;
+    if (IsEqualIID(id, IID_IUnknown) || IsEqualIID(id, IID_ITfTextEditSink))
+      *object = static_cast<ITfTextEditSink*>(this);
+    else if (IsEqualIID(id, IID_ITfTextLayoutSink))
+      *object = static_cast<ITfTextLayoutSink*>(this);
+    else return E_NOINTERFACE;
+    AddRef();
+    return S_OK;
+  }
+  STDMETHODIMP_(ULONG) AddRef() override { return InterlockedIncrement(&references_); }
+  STDMETHODIMP_(ULONG) Release() override {
+    const ULONG count = InterlockedDecrement(&references_);
+    if (!count) delete this;
+    return count;
+  }
+  STDMETHODIMP OnEndEdit(ITfContext* context, TfEditCookie ec, ITfEditRecord* record) override {
+    const com_ptr<CTextEditEventSink> keepAlive(this);
+    const auto binding = Current();
+    return binding ? service_->OnEndEdit(context, ec, record) : S_OK;
+  }
+  STDMETHODIMP OnLayoutChange(ITfContext* context, TfLayoutCode code,
+      ITfContextView* view) override {
+    const com_ptr<CTextEditEventSink> keepAlive(this);
+    const auto binding = Current();
+    return binding ? service_->OnLayoutChange(context, code, view) : S_OK;
+  }
+ private:
+  std::shared_ptr<WeaselTSF::TextEditBinding> Current() const {
+    const auto binding = binding_.lock();
+    if (!binding || !binding->candidate || service_->_textEditBinding != binding ||
+        service_->_cand != binding->candidate) return nullptr;
+    return binding;
+  }
+  LONG references_ = 1;
+  WeaselTSF* service_;
+  std::weak_ptr<WeaselTSF::TextEditBinding> binding_;
+};
+
+static HRESULT IsRangeCovered(TfEditCookie ec,
+                              ITfRange* pRangeTest,
+                              ITfRange* pRangeCover,
+                              BOOL* covered) {
+  LONG comparison;
+  HRESULT hr = pRangeCover->CompareStart(ec, pRangeTest, TF_ANCHOR_START,
+                                        &comparison);
+  if (hr != S_OK)
+    return hr;
+  if (comparison > 0) {
+    *covered = FALSE;
+    return S_OK;
+  }
+  hr = pRangeCover->CompareEnd(ec, pRangeTest, TF_ANCHOR_END, &comparison);
+  if (hr != S_OK)
+    return hr;
+  *covered = comparison >= 0;
+  return S_OK;
+}
+
+STDAPI WeaselTSF::OnEndEdit(ITfContext* pContext,
+                            TfEditCookie ecReadOnly,
+                            ITfEditRecord* pEditRecord) {
+  // This notification belongs to the original selection/composition. Host
+  // queries can cancel it or publish another draft in the very same context.
+  com_ptr<ITfContext> context(pContext);
+  com_ptr<ITfComposition> composition = _pComposition;
+  com_ptr<ITfContext> editContext = _pEditSessionContext;
+  const auto intent = _responseIntent;
+  const auto response = _lastResponse;
+  const auto binding = _textEditBinding;
+  const auto current = [&]() {
+    return _pComposition.p == composition.p &&
+           _pEditSessionContext.p == editContext.p && _responseIntent == intent &&
+           _lastResponse == response && _textEditBinding == binding;
+  };
+  BOOL fSelectionChanged = FALSE;
+
+  /* did the selection change? */
+  const HRESULT selection_status = pEditRecord->GetSelectionStatus(&fSelectionChanged);
+  _PromptTrace(prompt_trace::EndEdit, context, composition,
+      fSelectionChanged ? prompt_trace::SelectionChanged : 0, selection_status);
+  if (_textEditBinding != binding || (binding && _cand != binding->candidate)) return S_OK;
+  // Record the context's visible selection revision even if a host query has
+  // already replaced the current draft. Cancellation below still targets only
+  // the unchanged snapshot; saved commit selections must see this notification.
+  const bool ownSelection = selection_status == S_OK && fSelectionChanged &&
+      _ObserveResponseSelection(context, ecReadOnly);
+  if (!current()) return S_OK;
+  const bool targetMatches = intent && response_owner::SameIdentity(intent->owner, context);
+  if (!current()) return S_OK;
+  const bool editContextMatches = response_owner::SameIdentity(context, editContext);
+  if (!current()) return S_OK;
+  if (selection_status == S_OK && fSelectionChanged) {
+    if (ownSelection) return S_OK;
+    if (!current()) return S_OK;
+    if (!composition) {
+      if (targetMatches) _AbortComposition(true, intent);
+    }
+    else if (editContextMatches) {
+      /* if the caret moves out of composition range, stop the composition */
+      TF_SELECTION tfSelection = {};
+      ULONG cFetched = 0;
+      const HRESULT selection_result = context->GetSelection(ecReadOnly,
+          TF_DEFAULT_SELECTION, 1, &tfSelection, &cFetched);
+      com_ptr<ITfRange> selection;
+      if (selection_result == S_OK && cFetched == 1)
+        selection.Attach(tfSelection.range);
+      _PromptTrace(prompt_trace::SelectionRead, context, composition,
+          selection_result == S_OK && cFetched == 1 ? prompt_trace::OperationTrue : 0,
+          selection_result);
+      if (!current()) return S_OK;
+      if (selection_result == S_OK && cFetched == 1) {
+        com_ptr<ITfRange> range;
+        const HRESULT range_result = composition->GetRange(&range);
+        _PromptTrace(prompt_trace::CompositionRangeRead, context, composition, 0, range_result);
+        if (!current()) return S_OK;
+        if (range_result == S_OK) {
+          com_ptr<ITfContext> owner;
+          BOOL covered = FALSE;
+          const HRESULT owner_result = range->GetContext(&owner);
+          if (!current()) return S_OK;
+          const bool sameOwner = owner_result == S_OK &&
+              response_owner::SameIdentity(owner, context);
+          if (!current()) return S_OK;
+          // Both comparisons read the retained original range. Their result
+          // may cancel only that same still-current draft, never a replacement.
+          const HRESULT compare_result = sameOwner ?
+              IsRangeCovered(ecReadOnly, selection, range, &covered) :
+              (owner_result == S_OK ? S_FALSE : owner_result);
+          _PromptTrace(prompt_trace::RangeCompared, context, composition,
+              (sameOwner ? prompt_trace::OwnerMatches : 0) |
+              (covered ? prompt_trace::Covered : 0), compare_result);
+          if (!current()) return S_OK;
+          if (sameOwner &&
+              compare_result == S_OK && !covered) {
+            // Source-aware cancellation consults A's shared intent, never the
+            // latest unrelated IPC body and never B's composition/cookie.
+            if (targetMatches) _AbortComposition(true, intent);
+          }
+        }
+      }
+    }
+  }
+
+  return S_OK;
+}
+
+STDAPI WeaselTSF::OnLayoutChange(ITfContext* context,
+                                 TfLayoutCode code,
+                                 ITfContextView* view) {
+  const auto binding = _textEditBinding;
+  const com_ptr<CCandidateList> candidate = _cand;
+  if (!binding || !candidate || binding->candidate != candidate ||
+      (! _IsComposing() && !_HasCurrentPreedit())) return S_OK;
+  const auto current = [this, binding, candidate]() {
+    return _textEditBinding == binding && _cand == candidate;
+  };
+  const bool same = response_owner::SameIdentity(context, binding->context);
+  if (!current() || !same) return S_OK;
+  if (code == TF_LC_CHANGE) {
+    const auto packet = candidate->PresentedResponse();
+    const auto intent = packet ? packet->outputIntent.lock() : nullptr;
+    const bool owns = intent && response_owner::SameIdentity(intent->owner, context);
+    if (current() && owns && _IsPresentedResponse(packet))
+      _UpdateCompositionWindow(packet, view);
+  }
+  return S_OK;
+}
+
+WeaselTSF::TextEditBinding::~TextEditBinding() { Disconnect(); }
+
+void WeaselTSF::TextEditBinding::Disconnect() {
+  // Revoke our two exact cookies before a host callback can retire us again.
+  // A nested focus owns another cell, never these out parameters or cookies.
+  const DWORD edit = editCookie, layout = layoutCookie;
+  editCookie = layoutCookie = TF_INVALID_COOKIE;
+  if (!source) return;
+  if (edit != TF_INVALID_COOKIE) source->UnadviseSink(edit);
+  if (layout != TF_INVALID_COOKIE) source->UnadviseSink(layout);
+}
+
+BOOL WeaselTSF::_InitTextEditSink(ITfDocumentMgr* documentSource,
+    std::shared_ptr<TextEditBinding>* issued) {
+  auto request = std::make_shared<TextEditBinding>();
+  if (documentSource) request->candidate = _cand;
+  const auto previous = std::move(_textEditBinding);
+  _textEditBinding = request;
+  if (issued) *issued = request;
+  // Capture the request's activation before AddRef can reenter with B. The
+  // caller's raw callback argument stays borrowed until this local owns it.
+  com_ptr<ITfDocumentMgr> document(documentSource);
+  // Publish the replacement before the first Unadvise/GetTop/QI/Advise call.
+  // Even an empty request supersedes a half-finished old focus subscription.
+  if (previous) previous->Disconnect();
+  const auto current = [this, request]() {
+    return _textEditBinding == request &&
+        (!request->candidate || _cand == request->candidate);
+  };
+  const auto stale = [&]() {
+    request->Disconnect();
+    return FALSE;
+  };
+  if (!current()) return stale();
+  if (!document) return TRUE;
+  if (!request->candidate) return FALSE;  // No active candidate/activation.
+
+  HRESULT result = document->GetTop(&request->context);
+  if (!current()) return stale();
+  if (result != S_OK) return FALSE;
+  if (!request->context) return TRUE;
+  result = request->context->QueryInterface(IID_ITfSource,
+      reinterpret_cast<void**>(&request->source));
+  if (!current()) return stale();
+  if (result != S_OK || !request->source) return FALSE;
+
+  com_ptr<CTextEditEventSink> observer;
+  observer.Attach(new CTextEditEventSink(this, request));
+  request->observer = static_cast<ITfTextEditSink*>(observer.p);
+
+  // Cookies are first returned to this call's stack. Advise may reenter and
+  // retire the cell before writing the out value; that late value is still
+  // recorded here and disconnected from this exact ITfSource, not B's.
+  DWORD cookie = TF_INVALID_COOKIE;
+  result = request->source->AdviseSink(IID_ITfTextEditSink,
+      request->observer, &cookie);
+  if (result == S_OK) request->editCookie = cookie;
+  if (!current()) return stale();
+
+  cookie = TF_INVALID_COOKIE;
+  result = request->source->AdviseSink(IID_ITfTextLayoutSink,
+      request->observer, &cookie);
+  if (result == S_OK) request->layoutCookie = cookie;
+  if (!current()) return stale();
+  return request->editCookie != TF_INVALID_COOKIE ||
+      request->layoutCookie != TF_INVALID_COOKIE;
+}
