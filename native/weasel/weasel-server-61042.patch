+void WeaselTSF::_InitActivationCallbacks(const Activation& activation) {
+  com_ptr<CActivationEventSink> callbacks;
+  callbacks.Attach(new CActivationEventSink(this, activation));
+  activation->threadEventsSink = static_cast<ITfThreadMgrEventSink*>(callbacks.p);
+  activation->threadFocusSink = static_cast<ITfThreadFocusSink*>(callbacks.p);
+  activation->keySink = static_cast<ITfKeyEventSink*>(callbacks.p);
+}
