+std::shared_ptr<response_owner::Packet> CCandidateList::PresentedResponse() const {
+  const auto packet = _published.lock();
+  if (_phase != Phase::Active || !_IsDesired(packet) ||
+      _registeredIntent != packet->outputIntent.lock())
+    return nullptr;
+  return packet;
+}
+
+std::shared_ptr<response_owner::Packet> CCandidateList::HostActionResponse() const {
+  // Outside a native notification only an acknowledged publication may act.
+  const auto publishing = _publishing.lock();
+  if (!publishing) return PresentedResponse();
+  // Begin/Update callbacks describe this scoped packet even if a nested
+  // RequestUI has already replaced desired with another packet.
+  if (_phase != Phase::Beginning && _phase != Phase::Active) return nullptr;
+  const auto requested = _desired.lock();
+  const auto latest = _tsf->_lastResponse;
+  if (!requested || !latest || !latest->response ||
+      !latest->response->status.composing || !_tsf->_IsLatestResponse(latest))
+    return nullptr;
+  const auto intent = latest->outputIntent.lock();
+  if (_registeredIntent != intent ||
+      publishing->outputIntent.lock() != intent ||
+      requested->outputIntent.lock() != intent) return nullptr;
+  // A commit's new output must first become an actual UI request. Only a
+  // no-commit acknowledgement may advance beyond the displayed request.
+  if (latest != publishing && !latest->response->commit.empty()) return nullptr;
+  const auto& shown = publishing->response->context;
+  const auto& next = latest->response->context;
+  auto same_strings = [](const std::vector<Text>& a, const std::vector<Text>& b) {
+    if (a.size() != b.size()) return false;
+    for (size_t i = 0; i < a.size(); ++i)
+      if (a[i].str != b[i].str) return false;
+    return true;
+  };
+  // Highlight and other display attributes may change after SetSelection.
+  // Actual input, candidate indices/strings, labels/comments and page may not.
+  if (shown.preedit.str != next.preedit.str ||
+      shown.cinfo.currentPage != next.cinfo.currentPage ||
+      shown.cinfo.totalPages != next.cinfo.totalPages ||
+      shown.cinfo.is_last_page != next.cinfo.is_last_page ||
+      !same_strings(shown.cinfo.candies, next.cinfo.candies) ||
+      !same_strings(shown.cinfo.comments, next.cinfo.comments) ||
+      !same_strings(shown.cinfo.labels, next.cinfo.labels)) return nullptr;
+  return latest;
+}
