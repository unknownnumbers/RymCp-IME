+/* Pipe based IPC channel */
+template <typename _TyMsg,
+          typename _TyRes = DWORD,
+          size_t _MsgSize = sizeof(_TyMsg),
+          size_t _ResSize = sizeof(_TyRes)>
+class PipeChannel : public PipeChannelBase {
+ public:
+  /* Type definitions */
+
+  using Ptr = std::shared_ptr<PipeChannel>;
+  using UPtr = std::unique_ptr<PipeChannel>;
+  using Msg = _TyMsg;
+  using Res = _TyRes;
+  using Outcome = TransactionOutcome<Res>;
+
+  enum class ChannalCommand { NEW_MSG_PIPE, REFRESH };
+
+ public:
+  PipeChannel(std::wstring&& pn_cmd,
+              SECURITY_ATTRIBUTES* s = NULL,
+              size_t bs = 64 * 1024)
+      : PipeChannelBase(std::move(pn_cmd), bs, s) {}
+
+ public:
+  /* Common pipe operations */
+
+  bool Connect() {
+    if (_Ensure()) return true;
+    _AbandonTransaction();
+    return false;
+  }
+  bool Connected() const { return !_Invalid(hpipe); }
+  std::uint64_t ResponseGeneration() const {
+    return response_data_valid ? response_generation : 0;
+  }
+  void Disconnect() { _AbandonTransaction(); }
+
+  /* Write data to buffer */
+
+  template <typename _TyWrite>
+  void Write(_TyWrite cnt) {
+    try {
+      has_body = true;
+      _BufferWriteStream() << cnt;
+    } catch (...) {
+      _AbandonTransaction();
+      throw;
+    }
+  }
+
+  /* Write data to buffer */
+  template <typename _TyWrite>
+  PipeChannel& operator<<(_TyWrite cnt) {
+    Write(cnt);
+    return *this;
+  }
+
+  Outcome TransactOutcome(Msg& msg) {
+    static_assert(_ResSize == sizeof(Res), "A reply header must be complete");
+    Outcome outcome;
+    response_data_valid = false;
+    try {
+      if (!_Ensure(&outcome.error)) {
+        _AbandonTransaction();
+        return outcome;
+      }
+      *reinterpret_cast<Msg*>(buffer.get()) = msg;
+      const size_t size = has_body ? buff_size : _MsgSize;
+      // From this point failure cannot prove that the server did not execute.
+      outcome.phase = TransactionPhase::WriteAttempted;
+      _WritePipe(hpipe, size, buffer.get());
+      ClearBufferStream();
+      _Receive(hpipe, &outcome.reply, _ResSize, outcome.phase);
+    } catch (DWORD error) {
+      outcome.error = error != ERROR_SUCCESS ? error : ERROR_GEN_FAILURE;
+      _AbandonTransaction();
+    } catch (...) {
+      _AbandonTransaction();
+      throw;
+    }
+    return outcome;
+  }
+
+  _TyRes Transact(Msg& msg) {
+    const auto outcome = TransactOutcome(msg);
+    if (!outcome.Complete()) throw outcome.error;
+    return outcome.reply;
+  }
+
+  // A header-only metadata transaction does not touch a pending request body,
+  // the published content buffer, or its response generation on success.
+  // Failure invalidates the connection and both pending/published bodies.
+  template <typename Handler>
+  bool TransactLocalResponse(Msg& msg, _TyRes& result, Handler handler) {
+    static_assert(_ResSize == sizeof(Res), "A reply header must be complete");
+    try {
+      if (!_Ensure()) {
+        _AbandonTransaction();
+        return false;
+      }
+      auto body = std::make_unique<char[]>(buff_size);
+      Res reply{};
+      TransactionPhase phase = TransactionPhase::WriteAttempted;
+      _WritePipe(hpipe, _MsgSize, reinterpret_cast<char*>(&msg));
+      if (!_ReceiveInto(hpipe, &reply, _ResSize, body.get(), buff_size, phase) ||
+          !handler(reinterpret_cast<LPWSTR>(body.get()),
+                   static_cast<UINT>(buff_size / sizeof(wchar_t)))) {
+        _AbandonTransaction();
+        return false;
+      }
+      result = reply;
+      return true;
+    } catch (...) {
+      _AbandonTransaction();
+      throw;
+    }
+  }
+
+  void ClearBufferStream() {
+    has_body = false;
+    if (write_stream != nullptr) {
+      delete write_stream.release();
+      write_stream.reset(nullptr);
+    }
+  }
+
+  char* SendBuffer() const { return buffer.get() + _MsgSize; }
+
+  char* ReceiveBuffer() const { return buffer.get() + _ResSize; }
+
+  template <typename _TyHandler>
+  bool HandleResponseData(_TyHandler const& handler) {
+    if (!handler || !response_data_valid) {
+      return false;
+    }
+
+    // Use whole buffer to receive data in client
+    return handler((LPWSTR)buffer.get(),
+                   (UINT)(buff_size * sizeof(char) / sizeof(wchar_t)));
+  }
+
+ protected:
+  void _AbandonTransaction() {
+    ClearBufferStream();
+    _FinalizePipe(hpipe);
+  }
+
+  Stream& _BufferWriteStream() {
+    if (write_stream == nullptr) {
+      char* pbuff = (char*)buffer.get() + _MsgSize;
+      memset(pbuff, 0, buff_size - _MsgSize);
+      write_stream =
+          std::make_unique<Stream>((wchar_t*)pbuff, _SendBufferSizeW());
+    }
+    return *write_stream;
+  }
+
+ private:
+  inline size_t _SendBufferSizeW() const {
+    return (buff_size - _MsgSize) * sizeof(char) / sizeof(wchar_t);
+  }
+
+  inline size_t _ReceiveBufferSizeW() const {
+    return (buff_size - _ResSize) * sizeof(char) / sizeof(wchar_t);
+  }
+};
+};  // namespace weasel
