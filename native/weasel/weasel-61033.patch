+        static_cast<LONG>(response->commit.size()));
+    _PromptTrace(prompt_trace::InsertWritten, source->owner, source->composition,
+        prompt_trace::PendingCommit, packet->writeResult,
+        response->commit.size(), -1, -1, response->generation);
+    if (FAILED(packet->writeResult)) {
+      packet->stage = Stage::Failed;
+      _FinishResponseFollowers(packet);
+      return packet->writeResult;
+    }
+    packet->textWritten = true;
+    packet->stage = Stage::Written;
+    // Preserve the complete written range. The caret is an independent clone.
+    HRESULT firstFailure = source->range->Clone(&packet->endAnchor);
+    if (SUCCEEDED(firstFailure)) firstFailure = packet->endAnchor->Collapse(ec, TF_ANCHOR_END);
+    packet->endAnchorValid = SUCCEEDED(firstFailure);
+    if (SUCCEEDED(firstFailure)) firstFailure = _SetResponseSelection(ec, source, packet->endAnchor);
+    com_ptr<ITfProperty> attributes;
+    result = source->owner->GetProperty(GUID_PROP_ATTRIBUTE, &attributes);
+    if (SUCCEEDED(result)) result = attributes->Clear(ec, source->range);
+    if (SUCCEEDED(firstFailure) && FAILED(result)) firstFailure = result;
+    if (source->composition && !source->terminated) {
+      if (_IsCurrentComposition(source->composition)) _FinalizeComposition();
+      result = source->composition->EndComposition(ec);
+      packet->compositionClosed = SUCCEEDED(result) || source->terminated;
+      if (SUCCEEDED(firstFailure) && FAILED(result)) firstFailure = result;
+    } else packet->compositionClosed = true;
+    // Only a matching termination callback proves that End already completed.
+    // An unobserved E_UNEXPECTED is still Written, never fabricated Done.
+    packet->cleanupResult = firstFailure;
+    if (SUCCEEDED(firstFailure)) packet->stage = Stage::Done;
+    _FinishResponseFollowers(packet);
+    if (packet->stage != Stage::Done) {
+      _RetireRejectedEmptyUi(packet);
+      return firstFailure;
+    }
+  }
+
+  // The commit above is A-owned even if a COM call installed B. Every following
+  // language bar, preedit or candidate operation must still belong to latest A.
+  if (!_IsLatestResponse(packet)) return S_OK;
+  auto output = packet->outputIntent.lock();
+  if (!output) return S_OK;
+  _status = response->status;
+  _cand->style() = response->style;
+  _committed = commit;
+  _pEditSessionContext = output->owner;
+  if (!_IsLatestResponse(packet)) return S_OK;
+  _UpdateLanguageBar(_status);
+  if (!_IsLatestResponse(packet)) return S_OK;
+
+  if (response->status.composing) {
+    if (!output->range) return E_UNEXPECTED;
+    if (!output->composition || output->terminated) {
+      com_ptr<ITfContextComposition> compositions;
+      result = output->owner->QueryInterface(IID_ITfContextComposition,
+          reinterpret_cast<void**>(&compositions));
+      if (FAILED(result) || !_IsLatestResponse(packet)) return result;
+      com_ptr<ITfComposition> composition;
+      result = compositions->StartComposition(ec, output->range, this, &composition);
+      if (FAILED(result) || !composition) return result;
+      output->composition = composition;
+      output->terminated = false;
+      // StartComposition calls the host. Abort can run before its new object
+      // is returned, so bind it to original A before testing latest again.
+      if (!_IsLatestResponse(packet)) {
+        result = composition->EndComposition(ec); // A only; never erase text or retire B.
+        packet->cleanupResult = result;
+        if (SUCCEEDED(result)) output->terminated = true;
+        else if (packet->textWritten) packet->stage = Stage::Written;
+        return SUCCEEDED(result) ? S_FALSE : result;
+      }
+      _SetComposition(composition);
+    }
+    if (!_IsLatestResponse(packet)) return S_OK;
+    _cand->StartUI();
+    if (!_IsLatestResponse(packet)) return S_OK;
+    if (response->config.inline_preedit) {
+      auto context = std::make_shared<weasel::Context>(response->context);
+      com_ptr<CInlinePreeditEditSession> preedit;
+      preedit.Attach(new CInlinePreeditEditSession(this, output->owner, output->composition, context, packet));
+      // Same grant and explicit owner, never another delayed shared response.
+      result = preedit->DoEditSession(ec);
+      if (FAILED(result) || !_IsLatestResponse(packet)) return result;
+    }
+    if (!_IsLatestResponse(packet)) return S_OK;
+    _UpdateCompositionWindow(output->owner);
+  } else if (!commit && output->composition && !output->terminated) {
+    if (!_IsLatestResponse(packet)) return S_OK;
+    _EndComposition(output->owner, true);
+  }
+  if (!_IsLatestResponse(packet)) return S_OK;
+  _candidateResponseIntent = output;
+  _UpdateUI(response->context, response->status);
+  // A completed commit has no candidate UI left to advertise. Updating the
+  // integrated UI can install a newer draft, which must keep its registration.
+  if (commit && !response->status.composing && _IsLatestResponse(packet))
+    _cand->EndUI();
+  _PromptTrace(prompt_trace::UpdateUiApplied, output->owner, output->composition,
+      response->status.composing ? prompt_trace::ParsedComposing : 0,
+      S_OK, response->commit.size(), response->context.preedit.str.size(), -1, response->generation);
+  return S_OK;
+}
