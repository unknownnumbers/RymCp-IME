diff --git a/WeaselUI/JpCommentInlineObject.h b/WeaselUI/JpCommentInlineObject.h
new file mode 100644
index 0000000..e059afa
--- /dev/null
+++ b/WeaselUI/JpCommentInlineObject.h
@@ -0,0 +1,226 @@
+#pragma once
+
+#include "JpCommentStyle.h"
+#include <d2d1_1.h>
+#include <dwrite_2.h>
+#include <wrl/client.h>
+#include <new>
+#include <algorithm>
+
+namespace weasel {
+namespace jp_comment {
+
+// Let DirectWrite keep the complete comment's wrapping, baseline and hit-test
+// geometry. Only each label glyph is an inline object with a lower baseline.
+class SmallLabel final : public IDWriteInlineObject {
+ public:
+  SmallLabel(IDWriteTextLayout* layout,
+             ID2D1RenderTarget* target,
+             ID2D1Brush* brush,
+             const DWRITE_INLINE_OBJECT_METRICS& metrics,
+             const DWRITE_OVERHANG_METRICS& overhang,
+             IDWriteTextLayout* annotation = nullptr,
+             ID2D1Brush* annotation_brush = nullptr,
+             float annotation_x = 0, float annotation_y = 0)
+      : layout_(layout), target_(target), brush_(brush),
+        metrics_(metrics), overhang_(overhang), annotation_(annotation),
+        annotation_brush_(annotation_brush),
+        annotation_x_(annotation_x), annotation_y_(annotation_y) {}
+
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid, void** object) override {
+    if (!object) return E_POINTER;
+    *object = nullptr;
+    if (iid != __uuidof(IUnknown) && iid != __uuidof(IDWriteInlineObject))
+      return E_NOINTERFACE;
+    *object = static_cast<IDWriteInlineObject*>(this);
+    AddRef();
+    return S_OK;
+  }
+  ULONG STDMETHODCALLTYPE AddRef() override {
+    return static_cast<ULONG>(InterlockedIncrement(&references_));
+  }
+  ULONG STDMETHODCALLTYPE Release() override {
+    const ULONG count = static_cast<ULONG>(InterlockedDecrement(&references_));
+    if (!count) delete this;
+    return count;
+  }
+  HRESULT STDMETHODCALLTYPE Draw(void*, IDWriteTextRenderer*, FLOAT x, FLOAT y,
+                                  BOOL, BOOL, IUnknown* effect) override {
+    Microsoft::WRL::ComPtr<ID2D1Brush> selected = brush_;
+    if (effect) {
+      Microsoft::WRL::ComPtr<ID2D1Brush> supplied;
+      if (SUCCEEDED(effect->QueryInterface(IID_PPV_ARGS(supplied.GetAddressOf()))))
+        selected = supplied;
+    }
+    if (!target_ || !selected || (annotation_ && !annotation_brush_))
+      return E_UNEXPECTED;
+    // The callback origin already contains the baseline displacement.
+    // Do not add it a second time or touch the outer shared pTextLayout.
+    target_->DrawTextLayout(D2D1::Point2F(x, y), layout_.Get(), selected.Get(),
+                            D2D1_DRAW_TEXT_OPTIONS_ENABLE_COLOR_FONT);
+    // A candidate's main glyph inherits highlight/drawing effects. Its
+    // presentation-only variant marker always keeps the ordinary text color.
+    if (annotation_)
+      target_->DrawTextLayout(D2D1::Point2F(x + annotation_x_, y + annotation_y_),
+                              annotation_.Get(), annotation_brush_.Get(),
+                              D2D1_DRAW_TEXT_OPTIONS_ENABLE_COLOR_FONT);
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE GetMetrics(DWRITE_INLINE_OBJECT_METRICS* value) override {
+    if (!value) return E_POINTER;
+    *value = metrics_;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE GetOverhangMetrics(DWRITE_OVERHANG_METRICS* value) override {
+    if (!value) return E_POINTER;
+    *value = overhang_;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE GetBreakConditions(DWRITE_BREAK_CONDITION* before,
+                                               DWRITE_BREAK_CONDITION* after) override {
+    if (!before || !after) return E_POINTER;
+    *before = *after = DWRITE_BREAK_CONDITION_NEUTRAL;
+    return S_OK;
+  }
+
+ private:
+  volatile LONG references_ = 1;
+  Microsoft::WRL::ComPtr<IDWriteTextLayout> layout_;
+  Microsoft::WRL::ComPtr<ID2D1RenderTarget> target_;
+  Microsoft::WRL::ComPtr<ID2D1Brush> brush_;
+  DWRITE_INLINE_OBJECT_METRICS metrics_;
+  DWRITE_OVERHANG_METRICS overhang_;
+  Microsoft::WRL::ComPtr<IDWriteTextLayout> annotation_;
+  Microsoft::WRL::ComPtr<ID2D1Brush> annotation_brush_;
+  float annotation_x_, annotation_y_;
+};
+
+inline HRESULT TightGlyph(IDWriteFactory* factory, IDWriteTextFormat* format,
+                          const std::wstring& text, float scale,
+                          Microsoft::WRL::ComPtr<IDWriteTextLayout>& layout,
+                          DWRITE_TEXT_METRICS& metrics, float& baseline,
+                          DWRITE_OVERHANG_METRICS& overhang) {
+  HRESULT hr = factory->CreateTextLayout(text.c_str(), static_cast<UINT32>(text.size()),
+                                        format, 4096, 4096, layout.GetAddressOf());
+  if (FAILED(hr)) return hr;
+  hr = layout->SetFontSize(format->GetFontSize() * scale,
+                            {0, static_cast<UINT32>(text.size())});
+  if (FAILED(hr)) return hr;
+  hr = layout->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_LEADING);
+  if (FAILED(hr)) return hr;
+  hr = layout->SetParagraphAlignment(DWRITE_PARAGRAPH_ALIGNMENT_NEAR);
+  if (FAILED(hr)) return hr;
+  hr = layout->SetWordWrapping(DWRITE_WORD_WRAPPING_NO_WRAP);
+  if (FAILED(hr)) return hr;
+  hr = layout->SetLineSpacing(DWRITE_LINE_SPACING_METHOD_DEFAULT, 0, 0);
+  if (FAILED(hr)) return hr;
+  hr = layout->GetMetrics(&metrics);
+  if (FAILED(hr)) return hr;
+  DWRITE_LINE_METRICS line = {};
+  UINT32 count = 0;
+  hr = layout->GetLineMetrics(&line, 1, &count);
+  if (FAILED(hr)) return hr;
+  baseline = line.baseline;
+  hr = layout->SetMaxWidth(metrics.widthIncludingTrailingWhitespace);
+  if (FAILED(hr)) return hr;
+  hr = layout->SetMaxHeight(metrics.height);
+  if (FAILED(hr)) return hr;
+  return layout->GetOverhangMetrics(&overhang);
+}
+
+inline HRESULT ApplyVariants(IDWriteFactory* factory, IDWriteTextFormat* format,
+    IDWriteTextLayout* outer, const std::wstring& text,
+    const std::vector<CandidateLabel>& labels, ID2D1RenderTarget* target,
+    ID2D1Brush* brush, ID2D1Brush* annotation_brush) {
+  if (labels.empty()) return S_OK;
+  // Let the inline object's metrics reserve its right subscript's width and
+  // descent. Measurement and painting therefore keep the following Hanzi clear.
+  HRESULT hr = outer->SetLineSpacing(DWRITE_LINE_SPACING_METHOD_DEFAULT, 0, 0);
+  if (FAILED(hr)) return hr;
+  for (const auto& label : labels) {
+    Microsoft::WRL::ComPtr<IDWriteTextLayout> glyph, annotation;
+    DWRITE_TEXT_METRICS gm = {}, bm = {};
+    DWRITE_OVERHANG_METRICS go = {}, bo = {};
+    float baseline = 0, annotation_baseline = 0;
+    hr = TightGlyph(factory, format, text.substr(label.position, label.length),
+                    1.0f, glyph, gm, baseline, go);
+    if (FAILED(hr)) return hr;
+    hr = TightGlyph(factory, format, std::wstring(1, label.label),
+                    kVariantScale, annotation, bm, annotation_baseline, bo);
+    if (FAILED(hr)) return hr;
+    const float annotation_x = gm.widthIncludingTrailingWhitespace;
+    const float annotation_y = baseline + format->GetFontSize() * kBaselineDrop -
+                                annotation_baseline;
+    const float width = annotation_x + bm.widthIncludingTrailingWhitespace;
+    const float height = (std::max)(gm.height, annotation_y + bm.height);
+    DWRITE_INLINE_OBJECT_METRICS metrics = {width, height, baseline, FALSE};
+    DWRITE_OVERHANG_METRICS overhang = {
+      (std::max)(0.0f, (std::max)(go.left, bo.left - annotation_x)),
+      (std::max)(0.0f, (std::max)(go.top, bo.top - annotation_y)),
+      (std::max)(0.0f, (std::max)(go.right - bm.widthIncludingTrailingWhitespace,
+                                 bo.right)),
+      (std::max)(0.0f, (std::max)(go.bottom - (height - gm.height),
+                                 bo.bottom - (height - annotation_y - bm.height)))};
+    auto* object = new (std::nothrow) SmallLabel(glyph.Get(), target, brush, metrics,
+        overhang, annotation.Get(), annotation_brush, annotation_x, annotation_y);
+    if (!object) return E_OUTOFMEMORY;
+    hr = outer->SetInlineObject(object, {static_cast<UINT32>(label.position),
+                                        static_cast<UINT32>(label.length)});
+    object->Release();
+    if (FAILED(hr)) return hr;
+  }
+  return S_OK;
+}
+
+inline HRESULT Apply(IDWriteFactory* factory,
+                     IDWriteTextFormat* format,
+                     IDWriteTextLayout* outer,
+                     const Parsed& parsed,
+                     ID2D1RenderTarget* target,
+                     ID2D1Brush* brush) {
+  for (const auto& label : parsed.labels) {
+    Microsoft::WRL::ComPtr<IDWriteTextLayout> label_layout;
+    HRESULT hr = factory->CreateTextLayout(&label.character, 1, format,
+                                           4096.0f, 4096.0f, label_layout.GetAddressOf());
+    if (FAILED(hr)) return hr;
+    hr = label_layout->SetFontSize(format->GetFontSize() * kLabelScale, {0, 1});
+    if (FAILED(hr)) return hr;
+    hr = label_layout->SetTextAlignment(DWRITE_TEXT_ALIGNMENT_LEADING);
+    if (FAILED(hr)) return hr;
+    hr = label_layout->SetParagraphAlignment(DWRITE_PARAGRAPH_ALIGNMENT_NEAR);
+    if (FAILED(hr)) return hr;
+    hr = label_layout->SetWordWrapping(DWRITE_WORD_WRAPPING_NO_WRAP);
+    if (FAILED(hr)) return hr;
+    hr = label_layout->SetLineSpacing(DWRITE_LINE_SPACING_METHOD_DEFAULT, 0.0f, 0.0f);
+    if (FAILED(hr)) return hr;
+    DWRITE_TEXT_METRICS text = {};
+    hr = label_layout->GetMetrics(&text);
+    if (FAILED(hr)) return hr;
+    DWRITE_LINE_METRICS line = {};
+    UINT32 count = 0;
+    hr = label_layout->GetLineMetrics(&line, 1, &count);
+    if (FAILED(hr)) return hr;
+    // Inline-object overhangs are relative to the reported object box, not
+    // the deliberately roomy 4096-DIP box used for the first measurement.
+    hr = label_layout->SetMaxWidth(text.widthIncludingTrailingWhitespace);
+    if (FAILED(hr)) return hr;
+    hr = label_layout->SetMaxHeight(text.height);
+    if (FAILED(hr)) return hr;
+    DWRITE_OVERHANG_METRICS overhang = {};
+    hr = label_layout->GetOverhangMetrics(&overhang);
+    if (FAILED(hr)) return hr;
+    DWRITE_INLINE_OBJECT_METRICS metrics = {
+        text.widthIncludingTrailingWhitespace, text.height,
+        line.baseline - format->GetFontSize() * kBaselineDrop, FALSE};
+    auto* object = new (std::nothrow) SmallLabel(label_layout.Get(), target, brush,
+                                               metrics, overhang);
+    if (!object) return E_OUTOFMEMORY;
+    hr = outer->SetInlineObject(object, {static_cast<UINT32>(label.position), 1});
+    object->Release();
+    if (FAILED(hr)) return hr;
+  }
+  return S_OK;
+}
+
+}  // namespace jp_comment
+}  // namespace weasel
diff --git a/WeaselUI/JpCommentStyle.h b/WeaselUI/JpCommentStyle.h
new file mode 100644
index 0000000..0832c70
--- /dev/null
+++ b/WeaselUI/JpCommentStyle.h
@@ -0,0 +1,130 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace weasel {
+namespace jp_comment {
+
+// Horizontal-text candidate rows only; not a general markup language.
+constexpr float kLabelScale = 0.65f;
+constexpr float kBaselineDrop = 0.20f;
+constexpr float kVariantScale = 0.45f;
+
+struct Label {
+  size_t position;
+  wchar_t character;
+};
+
+struct Parsed {
+  std::wstring text;
+  std::vector<Label> labels;
+};
+
+struct Variant {
+  size_t codepoint;
+  wchar_t label;
+};
+
+struct VariantHeader {
+  bool valid = false;
+  size_t length = 0;
+  std::vector<Variant> variants;
+};
+
+// A private JP presentation prefix, never candidate text or a general markup
+// protocol. Indices are unique/increasing Unicode codepoint positions.
+inline VariantHeader ParseVariantHeader(const std::wstring& source) {
+  VariantHeader result;
+  if (source.compare(0, 4, L"[jp:") != 0) return result;
+  const size_t end = source.find(L']', 4);
+  if (end == std::wstring::npos || end == 4) return result;
+  size_t cursor = 4;
+  while (cursor < end) {
+    if (source[cursor] < L'0' || source[cursor] > L'9') return VariantHeader{};
+    size_t position = 0;
+    while (cursor < end && source[cursor] >= L'0' && source[cursor] <= L'9') {
+      const size_t digit = static_cast<size_t>(source[cursor++] - L'0');
+      if (position > (static_cast<size_t>(-1) - digit) / 10) return VariantHeader{};
+      position = position * 10 + digit;
+    }
+    if (cursor >= end || source[cursor++] != L'=' || cursor >= end)
+      return VariantHeader{};
+    const wchar_t label = source[cursor++];
+    if (label != L'\u65E7' && label != L'\u7570') return VariantHeader{};
+    if (!result.variants.empty() && position <= result.variants.back().codepoint)
+      return VariantHeader{};
+    result.variants.push_back({position, label});
+    if (cursor == end) break;
+    if (source[cursor++] != L',' || cursor == end) return VariantHeader{};
+  }
+  result.valid = true;
+  result.length = end + 1;
+  return result;
+}
+
+struct CandidateLabel {
+  size_t position;
+  size_t length;
+  wchar_t label;
+};
+
+inline bool IsHan(unsigned int value) {
+  return value == 0x3007 || (value >= 0x3400 && value <= 0x4dbf) ||
+      (value >= 0x4e00 && value <= 0x9fff) ||
+      (value >= 0xf900 && value <= 0xfaff) ||
+      (value >= 0x20000 && value <= 0x2fa1f) ||
+      (value >= 0x30000 && value <= 0x3347f);
+}
+
+inline std::vector<CandidateLabel> ParseCandidate(
+    const std::wstring& schema, const std::wstring& text, const std::wstring& comment) {
+  std::vector<CandidateLabel> labels;
+  if (schema != L"jp_sela") return labels;
+  const auto header = ParseVariantHeader(comment);
+  if (!header.valid) return labels;
+  size_t point = 0, next = 0;
+  for (size_t i = 0; i < text.size() && next < header.variants.size(); ++point) {
+    const size_t start = i;
+    unsigned int value = static_cast<unsigned int>(text[i++]);
+    if (value >= 0xd800 && value <= 0xdbff && i < text.size() &&
+        text[i] >= 0xdc00 && text[i] <= 0xdfff) {
+      value = 0x10000 + ((value - 0xd800) << 10) +
+              (static_cast<unsigned int>(text[i++]) - 0xdc00);
+    }
+    if (header.variants[next].codepoint == point) {
+      if (IsHan(value)) labels.push_back({start, i - start, header.variants[next].label});
+      ++next;
+    }
+  }
+  return labels;
+}
+
+// Positions refer to the displayed UTF-16 string after removing only the
+// underscore in the two exact, schema-scoped label tokens.
+inline Parsed Parse(const std::wstring& schema, const std::wstring& raw) {
+  Parsed result;
+  if (schema != L"jp_sela") {
+    result.text = raw;
+    return result;
+  }
+  const auto header = ParseVariantHeader(raw);
+  const std::wstring source = header.valid ? raw.substr(header.length) : raw;
+  size_t copied = 0;
+  for (size_t i = 0; i + 6 <= source.size(); ++i) {
+    if (source.compare(i, 4, L" | _") != 0 || source[i + 5] != L' ' ||
+        (source[i + 4] != L'\u8A13' && source[i + 4] != L'\u97F3' &&
+         source[i + 4] != L'\u4E2D'))
+      continue;
+    result.text.append(source, copied, i + 3 - copied);
+    result.labels.push_back({result.text.size(), source[i + 4]});
+    result.text.push_back(source[i + 4]);
+    copied = i + 5;
+    i += 4;
+  }
+  result.text.append(source, copied, std::wstring::npos);
+  return result;
+}
+
+}  // namespace jp_comment
+}  // namespace weasel
