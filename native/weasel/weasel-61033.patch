diff --git a/include/ShiftKeySnapshot.h b/include/ShiftKeySnapshot.h
new file mode 100644
index 0000000..8197759
--- /dev/null
+++ b/include/ShiftKeySnapshot.h
@@ -0,0 +1,55 @@
+#pragma once
+#include <cstdint>
+#include <string>
+
+namespace weasel {
+// Only this Shift event's facts. No keyboard bitmap, history, or focus epoch.
+struct ShiftKeySnapshot {
+  enum : unsigned {
+    Valid = 1, PrintableAnyDown = 2, LeftDown = 4, RightDown = 8,
+    RepeatDown = 16, KnownMask = 31
+  };
+  unsigned flags = 0;
+  std::uint32_t message_time = 0;
+  std::uint32_t original_vkey = 0;
+  std::uint32_t key_info = 0;
+  bool valid() const { return (flags & Valid) && !(flags & ~KnownMask); }
+  std::wstring Serialize() const {
+    return L"shift.v1=" + std::to_wstring(valid() ? flags : 0) + L"," +
+        std::to_wstring(message_time) + L"," + std::to_wstring(original_vkey) + L"," +
+        std::to_wstring(key_info) + L"\n";
+  }
+  std::string PropertyValue() const {
+    return valid() ? "v1:" + std::to_string(flags) + ":" + std::to_string(message_time) +
+        ":" + std::to_string(original_vkey) + ":" + std::to_string(key_info) : "invalid";
+  }
+  static ShiftKeySnapshot Parse(const wchar_t* body) {
+    ShiftKeySnapshot result;
+    if (!body) return result;
+    constexpr wchar_t prefix[] = L"shift.v1=";
+    unsigned i = 0;
+    for (; prefix[i]; ++i)
+      if (body[i] != prefix[i]) return result;
+    std::uint32_t values[4] = {};
+    for (unsigned field = 0; field < 4; ++field) {
+      std::uint64_t value = 0;
+      unsigned digits = 0;
+      for (; body[i] >= L'0' && body[i] <= L'9'; ++i) {
+        if (++digits > 10) return result;
+        value = value * 10 + (body[i] - L'0');
+        if (value > UINT32_MAX) return result;
+      }
+      if (!digits || body[i] != (field == 3 ? L'\n' : L',')) return result;
+      ++i;
+      values[field] = static_cast<std::uint32_t>(value);
+    }
+    if (body[i] || values[0] > KnownMask || !(values[0] & Valid) ||
+        (values[2] != 0x10 && values[2] != 0xa0 && values[2] != 0xa1)) return result;
+    result.flags = values[0];
+    result.message_time = values[1];
+    result.original_vkey = values[2];
+    result.key_info = values[3];
+    return result;
+  }
+};
+}  // namespace weasel
diff --git a/include/ShiftKeySnapshotWin.h b/include/ShiftKeySnapshotWin.h
new file mode 100644
index 0000000..6860322
--- /dev/null
+++ b/include/ShiftKeySnapshotWin.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <windows.h>
+#include <KeyEvent.h>
+
+namespace weasel {
+// Shared by TSF and IMM; only reads this callback's supplied keyboard state.
+inline ShiftKeySnapshot CaptureShiftSnapshot(
+    const KeyEvent& key, KeyInfo info, BOOL keyboard_state_valid,
+    const BYTE* state, HKL layout, UINT original_vkey, DWORD message_time) {
+  using Snapshot = ShiftKeySnapshot;
+  Snapshot result;
+  if (!keyboard_state_valid || !state ||
+      (key.keycode != ibus::Shift_L && key.keycode != ibus::Shift_R))
+    return result;
+  const bool left = (state[VK_LSHIFT] & 0x80) != 0;
+  const bool right = (state[VK_RSHIFT] & 0x80) != 0;
+  const bool own = key.keycode == ibus::Shift_L ? left : right;
+  if (own == static_cast<bool>(info.isKeyUp)) return result;
+  unsigned flags = Snapshot::Valid |
+      (left ? Snapshot::LeftDown : 0) | (right ? Snapshot::RightDown : 0);
+  if (!info.isKeyUp && info.prevKeyState) flags |= Snapshot::RepeatDown;
+  for (UINT vkey = VK_SPACE; vkey < 256; ++vkey) {
+    if (!(state[vkey] & 0x80)) continue;
+    // Unlike ToUnicode, this mapping does not mutate dead-key state.
+    const UINT character = MapVirtualKeyEx(vkey, MAPVK_VK_TO_CHAR, layout) & 0x7fffffff;
+    if (character >= 0x20) {
+      flags |= Snapshot::PrintableAnyDown;
+      break;
+    }
+  }
+  result.flags = flags;
+  result.message_time = message_time;
+  result.original_vkey = original_vkey;
+  result.key_info = static_cast<UINT32>(info);
+  return result;
+}
+}  // namespace weasel
