+static void JoinWithSentMessages(boost::thread& thread) {
+  HANDLE handle = thread.native_handle();
+  for (;;) {
+    DWORD wait = ::MsgWaitForMultipleObjectsEx(1, &handle, INFINITE,
+                                               QS_SENDMESSAGE,
+                                               MWMO_INPUTAVAILABLE);
+    if (wait == WAIT_OBJECT_0) {
+      thread.join();
+      return;
+    }
+    if (wait == WAIT_OBJECT_0 + 1) {
+      // Deliver synchronous cross-thread window calls made by an in-flight UI
+      // update. Leave posted input/menu messages queued while handlers drain.
+      MSG msg;
+      ::PeekMessage(&msg, NULL, 0, 0, PM_NOREMOVE);
+      continue;
+    }
+    throw std::system_error(::GetLastError(), std::system_category(),
+                            "Wait for IPC thread shutdown");
+  }
