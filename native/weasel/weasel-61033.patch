+    // No safe old endpoint: do not forward the original key into another app.
+    return true;
+  }
+  const bool handled = m_client.ProcessKeyEvent(key);
+  // Publish only a known handled Test, before capture can call COM/UI.
+  if (handled && publication) publication->Publish();
