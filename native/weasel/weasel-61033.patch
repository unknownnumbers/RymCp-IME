+void WeaselTSF::_FinishResponseFollowers(const std::shared_ptr<response_owner::Packet>& packet) {
+  using namespace response_owner;
+  auto next = packet->outputIntent.lock();
+  if (next && packet->endAnchorValid && packet->compositionClosed) {
+    // This is an already captured end anchor, not a later selection query.
+    next->range = packet->endAnchor;
+    next->initialSelection = false;
+    next->predecessor.reset();
+  } else if (next && !packet->textWritten &&
+             (packet->stage == Stage::Failed || packet->stage == Stage::UnsupportedEndpoint) &&
+             next->followsCommit && next->predecessor.lock() == packet) {
+    // This exact commit never produced a usable successor endpoint. Retire
+    // only its handoff intent so the next real key captures an endpoint again.
+    // Do not resend the failed commit or invalidate a newer context's intent.
+    next->valid = false;
+  }
+  auto followers = std::move(packet->followers);
+  packet->followers.clear();
+  for (const auto& child : followers) {
+    child->source->predecessor.reset();
+    if (packet->endAnchorValid && packet->compositionClosed) {
+      child->source->range = packet->endAnchor;
+      _QueueResponse(child, true);
+    } else {
+      child->stage = Stage::UnsupportedEndpoint;
+      child->writeResult = FAILED(packet->cleanupResult) ? packet->cleanupResult : E_UNEXPECTED;
+      _FinishResponseFollowers(child);
+    }
+  }
+}
