index 0000000..317b551
--- /dev/null
+++ b/WeaselTSF/PromptTrace.h
@@ -0,0 +1,254 @@
+#pragma once
+// Temporary, opt-in numeric diagnostic. No text/key payload is accepted.
+#include <windows.h>
+#include <cstdint>
+#include <cwchar>
+#include <locale>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+#pragma comment(lib, "advapi32.lib")
+
+namespace prompt_trace {
+constexpr wchar_t kRegistry[] = L"Software\\Rime\\Weasel\\TemporaryPromptTrace";
+constexpr size_t kCapacity = 8192;
+class LastErrorGuard {
+ public:
+  LastErrorGuard() noexcept : value_(GetLastError()) {}
+  ~LastErrorGuard() { SetLastError(value_); }
+ private:
+  DWORD value_;
+};
+enum Stage : unsigned {
+  CaptureStart = 1, KeyEnter = 10, KeyBypass = 11, KeyReturned = 12,
+  CallbackEnter = 13, CallbackReturned = 14,
+  MouseSelectBegin = 20, MouseSelectReturned = 21, MouseSyntheticQueued = 22,
+  MousePageBegin = 23, MousePageReturned = 24, MouseHoverBegin = 25, MouseHoverReturned = 26,
+  UpdateQueued = 30, UpdateGranted = 31, UpdateGrantOriginUnknown = 31, UpdateParsed = 32, CommitDecision = 33,
+  UpdateEndpointChecked = 34, UpdateRequestResult = 35, UpdateGrantResult = 36, UpdateUiApplied = 37,
+  StartQueued = 40, StartGranted = 41, StartCreated = 42, CurrentSet = 43,
+  InsertQueued = 50, InsertGranted = 51, InsertWritten = 52, InsertSelection = 53, InsertRange = 54,
+  EndQueued = 60, EndGranted = 61, EndRange = 62, EndCompleted = 63,
+  Finalized = 64, Terminated = 65, AbortBegin = 66, AbortCleared = 67,
+  KeyFocus = 70, DocumentFocus = 71, ContextPush = 72, ContextPop = 73,
+  ThreadFocus = 74, ThreadFocusReturned = 75, ThreadBlur = 76,
+  EndEdit = 80, RangeCompared = 81, CaretOutside = 82, SelectionRead = 83, CompositionRangeRead = 84, Deactivate = 90,
+  CaptureStop = 99
+};
+// The low flags are compositional state, not a keycode or a string.
+enum Flag : std::uint64_t {
+  Composing = 1, HasLocalComposition = 2, BodyValid = 4,
+  OperationTrue = 8, SelectionChanged = 16, Covered = 32,
+  OwnerMatches = 64, ClearRange = 128, KeyRelease = 256,
+  SpaceSelection = 512, DigitSelection = 1024, ReturnKey = 2048,
+  InlinePreedit = 4096, CommitEmptyAfterReservation = 8192, PendingCommit = 16384,
+  GrantSourceUnknown = 32768,
+  TestDownCallback = 65536, ActualDownCallback = 131072,
+  TestUpCallback = 262144, ActualUpCallback = 524288,
+  PendingPresent = 1048576, PendingMatched = 2097152,
+  BypassClosed = 4194304, BypassDisabled = 8388608,
+  BypassServer = 16777216, BypassConvert = 33554432,
+  BypassSimulated = 67108864, BypassEndpoint = 134217728,
+  ParsedComposing = 268435456, ParsedInline = 536870912
+};
+struct Lengths {
+  std::int64_t commit = -1, preedit = -1;
+};
+inline std::int64_t EscapedUnits(const wchar_t* first, const wchar_t* last) {
+  std::int64_t count = 0;
+  while (first < last) {
+    if (*first++ == L'\\' && first == last) break;
+    // Protocol unescape consumes any escaped following unit as one unit.
+    if (*(first - 1) == L'\\') ++first;
+    ++count;
+  }
+  return count;
+}
+// Count two exact fields directly. Never construct or store response strings,
+// candidates, comments, raw keys, paths, or titles.
+inline bool CountBody(wchar_t* buffer, unsigned capacity, Lengths& lengths) {
+  const wchar_t* first = buffer;
+  const wchar_t* limit = buffer + capacity;
+  while (first < limit && *first) {
+    const wchar_t* last = first;
+    while (last < limit && *last && *last != L'\n') ++last;
+    if (last - first == 1 && *first == L'.') return true;
+    if (last - first >= 7 && std::wmemcmp(first, L"commit=", 7) == 0)
+      lengths.commit = EscapedUnits(first + 7, last);
+    if (last - first >= 12 && std::wmemcmp(first, L"ctx.preedit=", 12) == 0)
+      lengths.preedit = EscapedUnits(first + 12, last);
+    if (last == limit || !*last) break;
+    first = last + 1;
+  }
+  return false;
+}
+struct Record {
+  std::uint64_t seq, ms, stage, owner, origin_context, current_context;
+  std::uint64_t captured_composition, current_composition, generation;
+  std::int64_t commit_length, preedit_length;
+  std::uint64_t flags;
+  std::int64_t range_empty, result;
+};
+class Recorder {
+ public:
+  bool Enabled() noexcept {
+    LastErrorGuard preserve;
+    Lock lock(lock_);
+    try { Refresh(); return active_; }
+    catch (...) { FailedLocked(); return false; }
+  }
+  std::uint64_t Emit(Stage stage, const void* owner, const void* origin,
+                     const void* current, const void* captured,
+                     const void* composition, std::uint64_t generation,
+                     std::int64_t commit, std::int64_t preedit,
+                     std::uint64_t flags, std::int64_t empty, HRESULT result) noexcept {
+    LastErrorGuard preserve;
+    Lock lock(lock_);
+    try {
+      Refresh();
+      if (!active_) return 0;
+      if (records_.size() + 1 >= kCapacity) { Stop(3); return 0; }
+      Record record{++seq_, GetTickCount64() - started_, stage, Id(owner), Id(origin),
+        Id(current), Id(captured), Id(composition), generation, commit, preedit,
+        flags, empty, static_cast<std::int64_t>(result)};
+      records_.push_back(record);
+      return record.seq;
+    } catch (...) { FailedLocked(); return 0; }
+  }
+  void Finish() noexcept {
+    LastErrorGuard preserve;
+    Lock lock(lock_);
+    try { if (active_) Stop(4); }
+    catch (...) { FailedLocked(); }
+  }
+  // Only the diagnostic boundary calls this, e.g. if std::function allocation
+  // fails while counting an IPC response. Do not retry or alter input state.
+  void Fail() noexcept {
+    LastErrorGuard preserve;
+    Lock lock(lock_); FailedLocked();
+  }
+ private:
+  class Lock {
+   public:
+    explicit Lock(SRWLOCK& lock) : lock_(lock) { AcquireSRWLockExclusive(&lock_); }
+    ~Lock() { ReleaseSRWLockExclusive(&lock_); }
+   private: SRWLOCK& lock_;
+  };
+  static std::uint64_t FileTimeNow() {
+    FILETIME time; GetSystemTimeAsFileTime(&time);
+    return (static_cast<std::uint64_t>(time.dwHighDateTime) << 32) | time.dwLowDateTime;
+  }
+  static bool IsCodexImage() {
+    wchar_t path[MAX_PATH];
+    const DWORD count = GetModuleFileNameW(nullptr, path, MAX_PATH);
+    if (!count || count >= MAX_PATH) return false;
+    const wchar_t* base = std::wcsrchr(path, L'\\'); base = base ? base + 1 : path;
+    // Only an explicitly selected supported UI process qualifies.
+    // The separate codex.exe CLI is excluded; TargetPid remains mandatory.
+    return _wcsicmp(base, L"ChatGPT.exe") == 0 || _wcsicmp(base, L"Code.exe") == 0 ||
+        _wcsicmp(base, L"GoldenDict.exe") == 0;
+  }
+  static bool ReadNumber(HKEY key, const wchar_t* name, DWORD type,
+                         void* value, DWORD bytes) {
+    DWORD actual = type, size = bytes;
+    return RegQueryValueExW(key, name, nullptr, &actual,
+      static_cast<BYTE*>(value), &size) == ERROR_SUCCESS && actual == type && size == bytes;
+  }
+  std::uint64_t Id(const void* pointer) {
+    if (!pointer) return 0;
+    for (const auto& value : ids_) if (value.first == pointer) return value.second;
+    const auto id = static_cast<std::uint64_t>(ids_.size() + 1);
+    ids_.emplace_back(pointer, id); return id;
+  }
+  void Status(DWORD error) {
+    HKEY key;
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, kRegistry, 0, KEY_QUERY_VALUE | KEY_SET_VALUE, &key) == ERROR_SUCCESS) {
+      DWORD process = 0; std::uint64_t capture = 0;
+      if (ReadNumber(key, L"TargetPid", REG_DWORD, &process, sizeof(process)) &&
+          ReadNumber(key, L"CaptureId", REG_QWORD, &capture, sizeof(capture)) &&
+          process == GetCurrentProcessId() && capture == capture_)
+        RegSetValueExW(key, L"LastError", 0, REG_DWORD,
+          reinterpret_cast<const BYTE*>(&error), sizeof(error));
+      RegCloseKey(key);
+    }
+  }
+  void FailedLocked() noexcept {
+    active_ = false;
+    Status(ERROR_UNHANDLED_EXCEPTION);
+  }
+  void Refresh() {
+    if (!image_checked_) { image_ok_ = IsCodexImage(); image_checked_ = true; }
+    if (!image_ok_) return;
+    const auto now = GetTickCount64();
+    if (active_ && (now >= ends_at_ || FileTimeNow() >= expires_)) { Stop(2); return; }
+    if (now < next_poll_) return;
+    next_poll_ = now + 250;
+    HKEY key;
+    DWORD enabled = 0, process = 0;
+    std::uint64_t capture = 0, expires = 0;
+    wchar_t output[MAX_PATH] = {};
+    DWORD output_type = REG_SZ, output_size = sizeof(output);
+    bool configured = RegOpenKeyExW(HKEY_CURRENT_USER, kRegistry, 0, KEY_QUERY_VALUE, &key) == ERROR_SUCCESS;
+    if (configured) {
+      configured = ReadNumber(key, L"Enabled", REG_DWORD, &enabled, sizeof(enabled)) &&
+        ReadNumber(key, L"TargetPid", REG_DWORD, &process, sizeof(process)) &&
+        ReadNumber(key, L"CaptureId", REG_QWORD, &capture, sizeof(capture)) &&
+        ReadNumber(key, L"ExpiresAt", REG_QWORD, &expires, sizeof(expires)) &&
+        RegQueryValueExW(key, L"OutputPath", nullptr, &output_type,
+          reinterpret_cast<BYTE*>(output), &output_size) == ERROR_SUCCESS &&
+        output_type == REG_SZ && output_size > sizeof(wchar_t) &&
+        output_size <= sizeof(output) && output[(output_size / sizeof(wchar_t)) - 1] == L'\0';
+      RegCloseKey(key);
+    }
+    const bool requested = configured && enabled == 1 && process == GetCurrentProcessId() &&
+      capture != 0 && expires > FileTimeNow();
+    if (active_ && (!requested || capture != capture_)) Stop(1);
+    if (!requested || capture == capture_) return;
+    // Opt-in is limited to two minutes even if a malformed control script asks longer.
+    const auto wall_now = FileTimeNow();
+    capture_ = capture;
+    if (expires <= wall_now) return;
+    if (expires - wall_now > 120ULL * 10000000ULL) { Status(ERROR_INVALID_PARAMETER); return; }
+    expires_ = expires; output_ = output;
+    ends_at_ = now + (expires - wall_now) / 10000ULL;
+    records_.clear(); records_.reserve(kCapacity); ids_.clear(); seq_ = 0;
+    started_ = now; active_ = true;
+    records_.push_back(Record{++seq_, 0, CaptureStart, 0, 0, 0, 0, 0, 0, -1, -1, 0, -1, S_OK});
+    Status(ERROR_IO_PENDING);
+  }
+  void Stop(std::uint64_t reason) {
+    records_.push_back(Record{++seq_, GetTickCount64() - started_, CaptureStop,
+      0, 0, 0, 0, 0, 0, -1, -1, reason, -1, S_OK});
+    active_ = false;
+    std::ostringstream text;
+    text.imbue(std::locale::classic());
+    text << "seq,ms,stage,owner,origin_ctx,current_ctx,captured_comp,current_comp,generation,commit_len,preedit_len,flags,range_empty,hr\n";
+    for (const auto& record : records_)
+      text << record.seq << ',' << record.ms << ',' << record.stage << ',' << record.owner << ','
+        << record.origin_context << ',' << record.current_context << ',' << record.captured_composition << ','
+        << record.current_composition << ',' << record.generation << ',' << record.commit_length << ','
+        << record.preedit_length << ',' << record.flags << ',' << record.range_empty << ',' << record.result << '\n';
+    const std::string bytes = text.str();
+    HANDLE file = CreateFileW(output_.c_str(), GENERIC_WRITE, FILE_SHARE_READ,
+      nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
+    DWORD error = ERROR_SUCCESS;
+    if (file == INVALID_HANDLE_VALUE) error = GetLastError();
+    else {
+      DWORD written = 0;
+      if (!WriteFile(file, bytes.data(), static_cast<DWORD>(bytes.size()), &written, nullptr)) error = GetLastError();
+      else if (written != bytes.size()) error = ERROR_WRITE_FAULT;
+      CloseHandle(file);
+    }
+    Status(error);
+    // No automatic retries, and a capture ID cannot restart itself.
+  }
+  SRWLOCK lock_ = SRWLOCK_INIT;
+  bool image_checked_ = false, image_ok_ = false, active_ = false;
+  std::uint64_t next_poll_ = 0, capture_ = 0, expires_ = 0, ends_at_ = 0, started_ = 0, seq_ = 0;
+  std::wstring output_;
+  std::vector<Record> records_;
+  std::vector<std::pair<const void*, std::uint64_t>> ids_;
+};
+inline Recorder& Get() { static Recorder value; return value; }
+}  // namespace prompt_trace
diff --git a/WeaselTSF/ResponseOwner.h b/WeaselTSF/ResponseOwner.h
new file mode 100644
index 0000000..7ade170
--- /dev/null
+++ b/WeaselTSF/ResponseOwner.h
@@ -0,0 +1,64 @@
+#pragma once
+#include <memory>
+#include <vector>
+#include <cstdint>
+#include <WeaselIPCData.h>
+
+// Only current intents and edit-session-owned packets are retained. No text
+// history, recovery store, or cross-client generation registry is maintained.
+namespace response_owner {
+inline bool SameIdentity(IUnknown* left, IUnknown* right) {
+  if (left == right) return left != nullptr;
+  if (!left || !right) return false;
+  com_ptr<IUnknown> a, b;
+  return SUCCEEDED(left->QueryInterface(IID_IUnknown, reinterpret_cast<void**>(&a))) &&
+         SUCCEEDED(right->QueryInterface(IID_IUnknown, reinterpret_cast<void**>(&b))) && a.p == b.p;
+}
+enum class Stage {
+  Prepared, AwaitEndpoint, Ready, Writing, Written, Done,
+  NoCommit, Failed, UnsupportedEndpoint
+};
+struct Packet;
+struct Intent {
+  std::uint64_t token = 0;
+  com_ptr<ITfContext> owner;
+  com_ptr<ITfComposition> composition;
+  com_ptr<ITfRange> range;
+  std::weak_ptr<Packet> predecessor;
+  bool followsCommit = false;
+  com_ptr<ITfRange> ownSelection;
+  bool initialSelection = true;
+  bool valid = true;
+  bool cancelled = false;
+  bool preparing = false;
+  bool hasCommit = false;
+  bool captureFailed = false;
+  bool terminated = false;
+};
+struct Response {
+  std::uint64_t generation = 0;
+  std::wstring commit;
+  weasel::Context context;
+  weasel::Status status;
+  weasel::Config config;
+  weasel::UIStyle style;
+};
+struct Packet {
+  std::shared_ptr<Intent> source;
+  std::weak_ptr<Intent> outputIntent;
+  std::shared_ptr<const Response> response;
+  com_ptr<ITfRange> commitBookmark;
+  com_ptr<ITfRange> endAnchor;
+  std::vector<std::shared_ptr<Packet>> followers;
+  Stage stage = Stage::Prepared;
+  HRESULT captureResult = E_PENDING;
+  HRESULT writeResult = E_PENDING;
+  HRESULT cleanupResult = E_PENDING;
+  unsigned writeAttempts = 0;
+  bool textWritten = false;
+  bool endAnchorValid = false;
+  bool compositionClosed = false;
+  bool scheduled = false;
+  bool updated = false;
