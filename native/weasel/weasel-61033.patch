+  if (self && message == kApplyGlobalNativeOpen) {
+    com_ptr<WeaselTSF> keepAlive(self);
+    self->_ApplyGlobalKeyboardOpen();
+    return 0;
+  }
+  if (self && message == WM_NCDESTROY) {
+    SetWindowLongPtrW(window, GWLP_USERDATA, 0);
+    LRESULT result = DefWindowProcW(window, message, wParam, lParam);
+    self->Release();
+    return result;
+  }
+  return DefWindowProcW(window, message, wParam, lParam);
+}
+
+HRESULT WeaselTSF::_InitGlobalKeyboardOpen() {
+  // A class per service instance avoids a process-wide registration counter.
+  swprintf_s(_nativeOpenWindowClass, L"WeaselNativeOpen_%p",
+             static_cast<void*>(this));
+  WNDCLASSW windowClass = {};
+  windowClass.lpfnWndProc = _NativeOpenWindowProc;
+  windowClass.hInstance = g_hInst;
+  windowClass.lpszClassName = _nativeOpenWindowClass;
+  if (!RegisterClassW(&windowClass))
+    return HRESULT_FROM_WIN32(GetLastError());
+  _nativeOpenWindow = CreateWindowExW(
+      0, _nativeOpenWindowClass, L"", 0, 0, 0, 0, 0, HWND_MESSAGE, nullptr,
+      g_hInst, this);
+  if (!_nativeOpenWindow)
+    return HRESULT_FROM_WIN32(GetLastError());
+
+  com_ptr<ITfCompartmentMgr> manager;
+  HRESULT hr = _pThreadMgr->GetGlobalCompartment(&manager);
+  if (FAILED(hr))
+    return hr;
+  hr = manager->GetCompartment(kGlobalNativeOpen, &_pGlobalKeyboardCompartment);
+  if (FAILED(hr))
+    return hr;
+  CComVariant initial;
+  hr = _pGlobalKeyboardCompartment->GetValue(&initial);
+  if (FAILED(hr))
+    return hr;
+  if (initial.vt == VT_EMPTY) {
+    CComVariant open(static_cast<LONG>(TRUE));
+    hr = _pGlobalKeyboardCompartment->SetValue(_tfClientId, &open);
+    if (FAILED(hr))
+      return hr;
+  } else if (initial.vt != VT_I4) {
+    return E_UNEXPECTED;
+  }
+
+  _pGlobalKeyboardCompartmentSink.Attach(new CCompartmentEventSink(
+      [this](REFGUID) {
+        // SetValue is forbidden inside a compartment OnChange notification.
+        _QueueGlobalKeyboardOpen();
+        return S_OK;
+      }));
+  hr = _pGlobalKeyboardCompartmentSink->_Advise((IUnknown*)manager,
+                                               kGlobalNativeOpen);
+  if (SUCCEEDED(hr))
+    _globalNativeOpenEnabled = true;
+  return hr;
+}
+
+void WeaselTSF::_UninitGlobalKeyboardOpen() {
+  _globalNativeOpenEnabled = false;
+  if (_pGlobalKeyboardCompartmentSink) {
+    _pGlobalKeyboardCompartmentSink->_Unadvise();
+    _pGlobalKeyboardCompartmentSink = nullptr;
+  }
+  _pGlobalKeyboardCompartment = nullptr;
+  if (_nativeOpenWindow) {
+    DestroyWindow(_nativeOpenWindow);
+    _nativeOpenWindow = nullptr;
+  }
+  if (_nativeOpenWindowClass[0]) {
+    UnregisterClassW(_nativeOpenWindowClass, g_hInst);
+    _nativeOpenWindowClass[0] = L'\0';
+  }
+  // The shared value belongs to the login session, not this application.
+}
+
+void WeaselTSF::_QueueGlobalKeyboardOpen() {
+  if (_nativeOpenWindow)
+    PostMessageW(_nativeOpenWindow, kApplyGlobalNativeOpen, 0, 0);
+}
+
+HRESULT WeaselTSF::_ReadGlobalKeyboardOpen(BOOL& open) {
+  if (!_pGlobalKeyboardCompartment)
+    return E_UNEXPECTED;
+  CComVariant value;
+  HRESULT hr = _pGlobalKeyboardCompartment->GetValue(&value);
+  if (FAILED(hr))
+    return hr;
+  if (value.vt != VT_I4)
+    return E_UNEXPECTED;
+  open = value.lVal != 0;
+  return S_OK;
+}
+
+HRESULT WeaselTSF::_ToggleGlobalKeyboardOpen() {
+  BOOL open;
+  HRESULT hr = _ReadGlobalKeyboardOpen(open);
+  if (FAILED(hr))
+    return hr;
+  CComVariant value(static_cast<LONG>(!open));
+  hr = _pGlobalKeyboardCompartment->SetValue(_tfClientId, &value);
+  if (SUCCEEDED(hr)) {
+    _ApplyGlobalKeyboardOpen();
+  }
+  return hr;
+}
+
+void WeaselTSF::_ApplyGlobalKeyboardOpen() {
+  if (!_globalNativeOpenEnabled)
+    return;
+  BOOL open;
+  if (FAILED(_ReadGlobalKeyboardOpen(open)))
+    return;
+  if (_IsKeyboardOpen() != open) {
+    HRESULT hr = _SetKeyboardOpen(open);
+    if (FAILED(hr)) {
+      return;
+    }
+  }
+  _EnableLanguageBar(open);
+  if (_pLangBarButton)
+    _pLangBarButton->UpdateWeaselStatus(_status);
+}
